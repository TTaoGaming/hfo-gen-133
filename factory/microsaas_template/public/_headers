# Cloudflare Pages headers — applied to every response.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://js.stripe.com https://checkout.stripe.com https://cal.com; connect-src 'self' https:; object-src 'none'; base-uri 'self'

/styles.css
  Cache-Control: public, max-age=3600
/app.js
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=86400
