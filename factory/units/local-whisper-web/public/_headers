# Local Whisper Web headers — override to allow Transformers.js CDN + HF model CDN.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://js.stripe.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://js.stripe.com https://checkout.stripe.com https://cal.com; connect-src 'self' https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://cas-bridge.xethub.hf.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'

/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: public, max-age=3600
/styles.css
  Cache-Control: public, max-age=3600
/app.js
  Cache-Control: public, max-age=3600
/whisper-tool.js
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=86400
