<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; base-uri 'none'; connect-src 'none'; font-src 'none'; form-action 'none'; frame-src 'none'; img-src 'none'; script-src 'none'; style-src 'unsafe-inline'">
  <title>{{DISPLAY_NAME_HTML}}</title>
  <style>
    body { font: 16px/1.5 system-ui, sans-serif; margin: 3rem auto; max-width: 48rem; padding: 0 1rem; }
    .boundary { border: 3px solid #8b0000; padding: 1rem; }
    dt { font-weight: 700; margin-top: 1rem; }
  </style>
</head>
<body>
  <main class="boundary" data-unit-id="{{UNIT_ID_HTML}}" data-classification="NON_PRODUCTION">
    <p><strong>NON_PRODUCTION - INERT LOCAL ARTIFACT - DO NOT PUBLISH</strong></p>
    <h1>{{DISPLAY_NAME_HTML}}</h1>
    <dl>
      <dt>Synthetic user job</dt><dd>{{USER_JOB_HTML}}</dd>
      <dt>Material outcome under test</dt><dd>{{MATERIAL_OUTCOME_HTML}}</dd>
      <dt>Local success threshold</dt><dd>{{SUCCESS_THRESHOLD_HTML}}</dd>
    </dl>
    <p>This page has no scripts, forms, external resources, analytics, deployment hooks, or payment controls.</p>
  </main>
</body>
</html>
