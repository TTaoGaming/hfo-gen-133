#!/usr/bin/env python3
"""Inert NON_PRODUCTION lifecycle adapter generated by the DLC factory."""

from __future__ import annotations

import argparse
import json


STAGES = ("install", "build", "test", "health", "rollback")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run one synthetic, local-only lifecycle phase."
    )
    parser.add_argument("stage", choices=STAGES)
    parser.add_argument("--force-failure", action="store_true")
    args = parser.parse_args()
    if args.force_failure and args.stage not in ("health", "rollback"):
        parser.error("--force-failure is allowed only for health or rollback")

    status = "SYNTHETIC_FAILURE" if args.force_failure else "SYNTHETIC_OK"
    record = {
        "classification": "NON_PRODUCTION",
        "effect": "NONE",
        "stage": args.stage,
        "status": status,
    }
    print(json.dumps(record, sort_keys=True, separators=(",", ":")))
    return 23 if args.force_failure else 0


if __name__ == "__main__":
    raise SystemExit(main())
