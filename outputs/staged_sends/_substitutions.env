# Substitution env applied at send time by Codex D1 SAFE-PUBLISH-BATCH.
# Format: NAME=value, one per line, no quotes, no interpolation.
# Placeholders in draft.json bodies (form: {{NAME}}) are replaced verbatim.
#
# Operator: replace the placeholder Cal.com URL with your REAL booking
# link before approving any class-line that publishes. If OPERATOR_BOOKING_LINK
# still contains the string "REPLACE_ME", D1 refuses to send and halts.

OPERATOR_BOOKING_LINK=https://cal.com/ttaogaming/ai-integration-rescue-REPLACE_ME

# Consistent sender identity string (also used in the landing-shell CTA fix).
OPERATOR_SENDER_NAME=Tao (TTaoGaming)
OPERATOR_REPLY_TO=ttaogaming@gmail.com

# Sanity check line — D1 aborts if this equals its default (forces the operator
# to acknowledge they've reviewed this file before firing).
ACKNOWLEDGED_BY_OPERATOR=NO
