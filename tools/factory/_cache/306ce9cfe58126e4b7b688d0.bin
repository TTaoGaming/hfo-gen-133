_name="view_jam" class="locale_en jam_layout_widget layout_widget responsive no_theme_toggle" data-host="itch.io"><div class="gray jam_layout_header_widget header_widget base_widget small_logo" id="jam_layout_header_2620647"><a href="#maincontent" class="skip_to_main">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a href="/" class="header_logo" title="itch.io - indie game hosting marketplace"><span class="visually_hidden">itch.io</span><img class="full_logo" alt="itch.io logo &amp; title" height="199" width="775" src="https://static.itch.io/images/logo-black-new.svg"/><img class="minimal_logo" alt="itch.io logo" height="235" width="262" src="https://static.itch.io/images/itchio-textless-black.svg"/></a></h1><div class="header_buttons"><a data-label="browse" class="header_button browse_btn" href="/games">Browse Games</a><a data-label="jams" class="header_button jams_btn" href="/jams">Game Jams</a><a data-label="developers" class="header_button developers_btn" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a data-label="devlogs" class="header_button devlogs_btn" href="/devlogs">Developer Logs</a><a data-label="community.home" class="header_button community.home_btn" href="/community">Community</a></div><form action="/search" class="game_search"><input name="q" type="text" placeholder="Search for games, jams, tags or creators" required="required" class="search_input"/><button aria-label="Search" class="submit_btn"><svg stroke-width="3" stroke-linecap="round" width="18" height="18" stroke="currentColor" stroke-linejoin="round" fill="none" aria-hidden role="img" class="svgicon icon_search" viewBox="0 0 24 24" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_3063558"><a data-label="log_in" class="panel_button" data-register_action="header" href="/login">Log in</a><a data-label="register" class="panel_button register_button" data-register_action="header" href="/register">Register</a></div></div><div class="header_dropdown" data-target="browse"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over has_banner" id="view_jam_2684157"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI3OTM0MDY4LnBuZw==/original/MjyNpc.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_3256897"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/syntys-12th-birthday-game-jam">Synty&#039;s 12th Birthday Game Jam</a></h1><div class="jam_host_header">Hosted by <a href="https://syntystudios.itch.io">Synty</a> · <a href="https://bsky.app/hashtag/SyntyJam">#SyntyJam</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/syntys-12th-birthday-game-jam/entries"><div class="stat_value">78</div><div class="stat_label">Entries</div></a></div><div class="stat_box"><div class="stat_value">1,104</div><div class="stat_label">Ratings</div></div></div></div><div class="header_tabs"><a data-label="tab_view_jam" class="header_tab active" href="/jam/syntys-12th-birthday-game-jam">Overview</a><a data-label="tab_view_jam_entries" class="header_tab" href="/jam/syntys-12th-birthday-game-jam/entries">Submissions</a><a class="header_tab" href="/jam/syntys-12th-birthday-game-jam/results">Results</a><div class="tab_group"><a class="header_tab" href="/jam/syntys-12th-birthday-game-jam/community">Community</a><span class="community_activity">13</span></div><a data-label="tab_view_jam_feed" class="header_tab" href="/jam/syntys-12th-birthday-game-jam/feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget after_voting is_over" id="jam_submitter_1842457"><p>This jam is now over. It ran from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-07 23:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-14 23:00:00</span>. <a href="/jam/syntys-12th-birthday-game-jam/results">View results</a></p></div></div><div class="jam_content user_formatted"><h1 class="text-center">A game jam to celebrate Synty Studios&#x27; 12th Birthday!&nbsp;</h1>
<h3 class="text-center">Please note for this jam you must use Synty assets, check out all&nbsp;Synty&#x27;s <a href="https://link.syntystore.com/synty-free-assets-bday-jam" rel="nofollow noopener" referrerpolicy="origin">FREE assets here</a>.</h3>
<h2></h2>
<hr>
<h3 class="text-center">Theme: Hide &amp; Seek</h3>
<h3 class="text-center"></h3>
<h3 class="text-center">Got more questions? Chat with the Synty team and&nbsp;other jammers!<br>Join our Discord: <a style="" href="https://discord.com/invite/syntystudios" rel="nofollow noopener" referrerpolicy="origin">https://discord.com/invite/syntystudios</a></h3>
<h3 class="text-center"><a href="https://discord.com/invite/syntystudios" rel="nofollow noopener" referrerpolicy="origin"></a></h3>
<h5></h5>
<hr>
<h2>🗳️ Voting Categories:&nbsp;</h2>
<p>&nbsp;🎮 Best Gameplay: The game that&#x27;s most enjoyable to play</p>
<p>&nbsp;📖 Best Theme: The game with the most innovative or best use of the Jam&#x27;s Theme</p>
<p>🃏 Wild Card Award: The game that wows in an unexpected way</p>
<p>⭐&nbsp;Synty&#x27;s Choice: The Synty team will play the top 5 overall games as voted by you, the public,&nbsp;and then select a winner!<br></p>
<p>Voting will be public for the first three categories, with the Synty&#x27;s Choice award picked by the Synty Team! We suggest trying to excel in one of these areas, not all!</p>
<p><br></p>
<p></p>
<h2>📋 Rules:</h2>
<p>Entry Requirements</p>
<ul><li>You must follow the theme given for the jam.
</li><li>This jam is for individuals only, no team entries.<br>
</li><li>Only Synty models may be used, kitbashing is allowed as long as you can tell visually that it is Synty assets being used.</li><li>By submitting an entry for this jam you agree that Synty can showcase your entry in our marketing, including but not limited to on our blog and social media channels.</li></ul>
<p>Allowed</p>
<ul><li>There are no restrictions on creation tools (controllers, scripts etc). Game jams are the perfect setting to learn a ton of new things in a safe environment, so feel free to work with the tools you&#x27;re comfortable with, some new feature you&#x27;ve been meaning to learn more about, or even a totally new game engine!&nbsp;</li><li>AI code tooling.</li><li>Entries can be made in any game engine.</li><li>Custom fonts and audio assets you have the legal right to use.&nbsp;</li></ul>
<p>Not Allowed</p>
<ul><li>3D assets that are not Synty.</li><li>Entirely custom art and models.&nbsp;Entries are to be visually predominantly Synty. You may sparingly use custom assets which you created, or have the legal rights to, for example for UI elements or fonts, as&nbsp;long as the game is visually predominantly&nbsp;Synty.&nbsp;</li><li>You cannot use any projects you have started previously. Your submission must be created entirely during the jam period.<br>
</li><li>Use of Generative AI for assets,&nbsp;text, images, audio, and video. This does not include AI code tooling.
</li><li>NSFW, please keep it clean (PG13) find more information in our FAQ below.</li></ul>
<p><br></p>
<h3>
</h3>
<h2>❓&nbsp;FAQ:</h2>
<p><strong>How long is the jam?</strong><br>This jam is 7 days long!</p>
<p><strong>Can I submit a game I started before the jam?</strong>&nbsp;<br>No, you cannot use any projects you have started previously. Your submission must be created from scratch.</p>
<p><strong>Can I use any assets that are not Synty?<br></strong>No, only Synty models may be used - kitbashing is allowed as long as you can tell visually that it is Synty assets being used.</p>
<p><strong>Can I include code, controllers, script etc in my project?</strong>&nbsp;<br>There are no restrictions on creation tools (Car/Character controllers, Unity store asset scripts ect). Game jams are the perfect setting to learn a ton of new things in a safe environment, so feel free to work with the tools you&#x27;re comfortable with, some new feature you&#x27;ve been meaning to learn more about, or even a totally new game engine!</p>
<p><strong>Does my game have to use a specific engine or comply with any technical restrictions?&nbsp;<br></strong>Nope! Your game can be developed using any engine, as long as your game can be played via the browser and/or on all desktop platforms (Windows, macOS, Linux).</p>
<p><strong>Can I submit a game that isn&#x27;t finished to the jam?</strong>&nbsp;<br>Absolutely! Unfinished or partially finished games are&nbsp;accepted, as long as they&#x27;re playable.</p>
<p><strong>Can I submit a game that includes adult, gory, or other offensive stuff in it?</strong>&nbsp;<br>Please keep your submission within the PG13 / Mature rating guidelines. Submissions that would be considered rated 18+ will not be accepted. Example: Any nudity has to be non-sexual, and any swear words have to be used sparingly. For the Jam, we will allow blood and minor amounts of gore. Think about whether you&#x27;d want a 12-13 year old child seeing the content! Any submissions containing hate speech will be removed.</p>
<p><strong>I found bugs or issues with my game after submissions ended. Can I change my submission?</strong>&nbsp;<br>Once submissions have ended, you will no longer be able to edit your submission. However, while the submission period is open, you are able to edit your submission.</p></div></div><div id="entries" class="grid_outer"><div class="header_row"><h2>Submissions<span class="game_count">(78)</span></h2></div><div class="jam_filter_picker"><div class="filter_item active">All submissions</div><span class="divider"> · </span><div data-filter="filter_web" class="filter_item">Browser playable (46)</div><span class="divider"> · </span><div data-filter="filter_windows" class="filter_item">Windows (34)</div><div data-filter="filter_osx" class="filter_item">macOS (4)</div><div data-filter="filter_linux" class="filter_item">Linux (2)</div></div><div class="jam_filter_empty"><p>No submissions match your filter</p></div><div class="game_grid_widget base_widget browse_game_grid"><div data-game_id="4775747" class="game_cell filter_windows has_cover lazy_images" dir="auto"><div class="game_thumb"><a data-label="game:4775747:thumb" class="thumb_link game_link" href="https://zrsio4.itch.io/a-mimic-in-the-dungeon" tabindex="-1" data-action="game_grid"><img class="lazy_loaded" data-lazy_src="https://img.itch.zone/aW1nLzI4NDc2NzkwLnBuZw==/315x250%23c/TJ0hlP.png" width="315" height="250"/></a><div class="game_cell_tools"><a href="/g/zrsio4/a-mimic-in-the-dungeon/add-to-collection" class="action_btn add_to_collection_btn" data-register_action="add_to_collection"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a data-action="game_grid" class="title game_link" href="https://zrsio4.itch.io/a-mimic-in-the-dungeon" data-label="game:4775747:title">A Mimic in the Dungeon</a></div><div title="You&#039;re a mimic. Don&#039;t get caught snacking on adventurers" class="game_text">You&#039;re a mimic. Don&#039;t get caught snacking on adventurers</div><div class="game_author"><a href="https://zrsio4.itch.io" data-action="game_grid" data-label="user:1808003">ZrSiO4 - Jessica</a></div><div class="game_genre">Adventure</div><div class="game_platform"><span class="icon icon-windows8" title="Download for Windows" aria-hidden="true"></span> </div></div></div><div data-game_id="4777096" class="game_cell filter_html filter_windows filter_web has_cover lazy_images" dir="auto"><div style="background-color:#000000;" class="game_thumb"><a data-label="game:4777096:thumb" class="thumb_link game_link" href="https://dritix.itch.io/the-night-seeker" tabindex="-1" data-action="game_grid"><img class="lazy_loaded" data-lazy_src="https://img.itch.zone/aW1nLzI4NDg1MTUzLnBuZw==/315x250%23c/G11kv%2F.png" width="315" height="250"/></a><div class="game_cell_tools"><a href="/g/dritix/the-night-seeker/add-to-collection" class="action_btn add_to_collection_btn" data-register_action="add_to_collection"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a data-action="game_grid" class="title game_link" href="https://dritix.itch.io/the-night-seeker" data-label="game:4777096:title">The Night Seeker</a></div><div title="Hide and Seek Horror game" class="game_text">Hide and Seek Horror game</div><div class="game_author"><a href="https://dritix.itch.io" data-action="game_grid" data-label="user:7145556">Dritix</a></div><div class="game_genre">Survival</div><div class="game_platform"><span class="web_flag">Play in browser</span><span class="icon icon-windows8" title="Download for Windows" aria-hidden="true"></span> </div></div></div><div data-game_id="4777356" class="game_cell filter_windows has_cover lazy_images" dir="auto"><div class="game_thumb"><a data-label="game:4777356:thumb" class="thumb_link game_link" href="https://alexkau.itch.io/seven-and-the-night" tabindex="-1" data-action="game_grid"><img class="lazy_loaded" data-la