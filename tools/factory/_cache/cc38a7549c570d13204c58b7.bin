}
.custom_paddbottom{
  margin-top:60px;
} </style></head><body data-page_name="view_jam" class="locale_en jam_layout_widget layout_widget responsive no_theme_toggle" data-host="itch.io"><div class="small_logo jam_layout_header_widget header_widget base_widget gray" id="jam_layout_header_5983675"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" title="itch.io - indie game hosting marketplace" href="/"><span class="visually_hidden">itch.io</span><img alt="itch.io logo &amp; title" class="full_logo" src="https://static.itch.io/images/logo-black-new.svg" height="199" width="775"/><img alt="itch.io logo" class="minimal_logo" src="https://static.itch.io/images/itchio-textless-black.svg" height="235" width="262"/></a></h1><div class="header_buttons"><a data-label="browse" class="header_button browse_btn" href="/games">Browse Games</a><a data-label="jams" class="header_button jams_btn" href="/jams">Game Jams</a><a data-label="developers" class="header_button developers_btn" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a data-label="devlogs" class="header_button devlogs_btn" href="/devlogs">Developer Logs</a><a data-label="community.home" class="header_button community.home_btn" href="/community">Community</a></div><form class="game_search" action="/search"><input required="required" class="search_input" type="text" name="q" placeholder="Search for games, jams, tags or creators"/><button aria-label="Search" class="submit_btn"><svg stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden stroke-width="3" fill="none" role="img" stroke="currentColor" viewBox="0 0 24 24" class="svgicon icon_search" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_4376928"><a data-register_action="header" class="panel_button" data-label="log_in" href="/login">Log in</a><a data-register_action="header" class="panel_button register_button" data-label="register" href="/register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default during_submit has_banner" id="view_jam_1999932"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI4OTQ1MjkxLnBuZw==/original/yEdsSB.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_7100854"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/back-in-the-game-jam">$250+ Back in the Game Jam</a></h1><div class="jam_host_header">Hosted by <a href="https://tokentakenuser.itch.io">tokentakenuser</a>, <a href="https://jattenalle.itch.io">Jattenalle</a>, <a href="https://minipaperplanes.itch.io">minipaperplanes</a> · <a href="https://bsky.app/hashtag/BackInTheGameJam">#BackInTheGameJam</a></div></div><div class="stats_container"><div class="stat_box"><div class="stat_value">487</div><div class="stat_label">Joined</div></div></div></div><div class="header_tabs"><a data-label="tab_view_jam" class="header_tab active" href="/jam/back-in-the-game-jam">Overview</a><div class="tab_group"><a class="header_tab" href="/jam/back-in-the-game-jam/community">Community</a><span class="community_activity">17</span></div></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget during_submit" id="jam_submitter_6834523"><div class="date_data">Submissions open from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-30 23:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-08-17 21:00:00</span></div><div class="countdown"><span class="countdown_label">Submissions due in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button data-method="post" class="button fat submitter_button join_jam_btn" data-href="/jam/416979/join">Join jam</button></div></div></div><div class="jam_content user_formatted"><div class="custom_banner_container"><img src="https://img.itch.zone/aW1nLzI3NTk3NDc0LnBuZw==/original/zL%2F5MW.png" class="custom_banner1" loading="lazy"></div>
<div class="custom_banner_container"><img src="https://img.itch.zone/aW1nLzI3NTk3NDcyLnBuZw==/original/cL0rMi.png" class="custom_banner2" loading="lazy"></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI4NzE0MzIyLnBuZw==/original/V%2FhfAK.png" loading="lazy"></p><p>&nbsp;</p>
<div class="custom_indent"><p>The theme of the jam is:</p><p class="custom_theme"><strong>Now That&#x27;s What I Call A Theme!</strong></p><p>
Pick your own theme that provides the perfect flavor for your game! Craft your entry with any theme of your choice. The more you lean into it-, the more obvious-, and the more integrated-, the better your theme score will be.</p>
<p>In addition to the theme, more judging score can be gained via:</p>
<p class="custom_theme"><strong>The Perfect Loop</strong></p>
<p>Focusing on tight, fun, iterative gameplay. Remember the short and sweet gameplay loop mechanics of the classics.</p>
<p>Let your creativity run wild, create the most addictive loop, embrace freedom!</p></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI4NzE0MzMwLnBuZw==/original/5k43ki.png" loading="lazy"></p>
<div class="custom_indent"><p>The prize pool has been increased to <strong>$250+!</strong></p><p>Less than one week to go until the theme is revealed and the jam begins!</p><p>Looking for a team or just want some feedback or talk gamedev? Join the <a href="https://discord.gg/7RxtpxSYRs" referrerpolicy="origin" rel="nofollow noopener"><strong>Gamedev Monastery</strong> Discord</a></p></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI3NzEwNzY3LnBuZw==/original/pwKCP2.png" loading="lazy"></p>
<div class="custom_indent"><p>Do you remember the heyday of game development? Unbridled enthusiasm. A new frontier. New technologies. Passionate men pushing the medium further and further, pursuing their own visions instead of bending to the demands of corporations, trends, or checklist design.</p>
<p>Those days are still here. They were never a moment in time. They are a state of mind.</p></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI3NzEwNzgwLnBuZw==/original/V9iBwn.png" loading="lazy"></p>
<div class="custom_indent"><p>Revive the spirits of the good old days without being revisionist. Utilize new tech to make good games, combine the best of the past, present, and future of game development.</p>
<p>Just make great fun games unshackled from the suffocation of modernity and <em>&quot;The Message&quot;</em></p></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI3NzEwNzg2LnBuZw==/original/icvM%2Bi.png" loading="lazy"></p>
<div class="custom_prizeburst"><img src="https://img.itch.zone/aW1nLzI4NzE0MzM0LnBuZw==/original/szKiP4.png" loading="lazy"></div>
<div class="custom_indent"><p>The Back in the Game Jam features a total prize pool of at-least <strong>$250</strong>, split between top three submissions.</p>
<p>Prizes will be distributed via either PayPal, Itch.io, or Steam Gifts at your request.</p>
</div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI3NzEwNzk4LnBuZw==/original/AEqpBg.png" loading="lazy"></p>
<div class="custom_indent"><p>The official channel for the jam is hosted by the <a href="https://discord.gg/7RxtpxSYRs" referrerpolicy="origin" rel="nofollow noopener"><strong>Gamedev Monastery</strong></a>.</p>
<p>A Discord server for Gamedevs who tread their own path. <a href="https://discord.gg/7RxtpxSYRs" referrerpolicy="origin" rel="nofollow noopener">Join us</a>, find a team and share your progress and approach with others!
</p></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI3NzEwODAyLnBuZw==/original/r6R4An.png" loading="lazy"></p>
<div class="custom_indent"><p>The judges are made up of experienced game developers and gamers.</p>
<h3><p>Criteria</p></h3><div class="custom_indent">
<ul><li><p><strong>Theme</strong></p>
<p>How well you hit the theme, <strong>Now That&#x27;s What I Call A Theme!</strong>, and theme gimmick <strong>The Perfect Loop</strong>.</p>
</li><li><p><strong>Gameplay</strong></p>
<p>How well designed your gameplay loop or loops are.</p>
</li><li><p><strong>Polish</strong></p>
<p>This is all about the execution, consistency, art direction, and presentation. A small highly polished game will score higher than a mess of random assets.</p>
</li></ul></div></div>
<p class="custom_title"><img src="https://img.itch.zone/aW1nLzI3NzEwODA1LnBuZw==/original/9eB%2FDq.png" loading="lazy"></p>
<div class="custom_indent"><p>Since we want unshackled game development, there are not many. But we have a few in place:</p><ul>
<li><p>No AI-Generated assets. Make your own stuff even if it&#x27;s just colored rectangles. This is about the craft.</p>
</li><li><p>No asset flips. See above. Original work is strongly encouraged.</p>
</li><li><p>Games should be stream-friendly.</p>
</li><li><p>If joining as a team you need to assign one person to receive the prize. It is up to you to distribute the prize within the team.</p>
</li><li><p>Games must be made for the jam.</p>
</li><li><p>We reserve the right to disqualify submissions.</p>
</li></ul></div>
<div class="custom_paddbottom">&nbsp;</div></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div id="add_game_to_jam_lightbox_5315718" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" tabIndex="-1" role="dialog"><button class="close_button"><svg stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden stroke-width="2" fill="none" role="img" stroke="currentColor" viewBox="0 0 24 24" class="svgicon icon_cross2" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fback-in-the-game-jam">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fback-in-the-game-jam">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_1999932', {"id":416979,"start_date":"2026-07-30 23:00:00","end_date":"2026-08-17 21:00:00"});init_JamLayoutHeader('#jam_layout_header_5983675', {"autocomplete_props":{"ca_source":25,"ca_types":{"game":1,"featured_tag":7,"browse_facet":8,"jam":4,"bundle":6},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
I.setup_page();</script></body></html>