"register" class="panel_button register_button" data-register_action="header" href="/register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default before_start has_banner" id="view_jam_8385782"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI4OTM5NDkzLnBuZw==/original/D3PE6I.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_9839210"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/maxters-jam-2026">maxter&#039;s JAM 2026</a></h1><div class="jam_host_header">Hosted by <a href="https://maxters.itch.io">maxter</a></div></div><div class="stats_container"><div class="stat_box"><div class="stat_value">372</div><div class="stat_label">Joined</div></div></div></div><div class="header_tabs"><a data-label="tab_view_jam" class="header_tab active" href="/jam/maxters-jam-2026">Overview</a><div class="tab_group"><a class="header_tab" href="/jam/maxters-jam-2026/community">Community</a><span class="community_activity">35</span></div></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget before_start" id="jam_submitter_799393"><div class="date_data">Submissions open from <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-08-22 09:00:00</span> to <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-08-25 09:00:00</span></div><div class="countdown"><span class="countdown_label">Starts in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button data-method="post" class="button fat submitter_button join_jam_btn" data-href="/jam/418750/join">Join jam</button></div></div></div><div class="jam_content user_formatted"><p></p>
<figure><img src="https://img.itch.zone/aW1nLzY1OTgxMjgucG5n/original/izpFoo.png" loading="lazy"><span></span><span></span></figure>
<p>Добро пожаловать на пятый официальный геймджем от канала&nbsp;<a href="https://www.youtube.com/maxters" referrerpolicy="origin" rel="nofollow noopener"><strong>maxter</strong></a>!
</p>
<p>Это увлекательное событие, в котором разработчики игр соревнуются друг с другом&nbsp;&mdash; кто сделает лучшую игру за 3 дня.&nbsp;
</p>
<p>Здесь абсолютно любой может испытать свои навыки.
</p>
<p>Ты новичок в разработке игр и думаешь, что не успеешь сделать игру за короткий срок?&nbsp;&mdash; Не бойся! Геймджем - это отличный первый опыт, ты можешь общаться с другими разработчиками&nbsp;в нашем&nbsp;<a target="_blank" href="https://discord.gg/n9QxzcC" referrerpolicy="origin" rel="nofollow noopener"><strong>Discord&nbsp;сервере</strong></a>, найти себе там команду, оценивать чужие игры и в целом с кайфом провести время.
</p>
<p><img src="https://img.itch.zone/aW1nLzY1OTgxMjUucG5n/original/4Qv7VQ.png" loading="lazy">
</p>
<p>Джем длится с 22 по 25 августа (начало и конец в&nbsp;12:00 МСК). Оценка работ будет доступна до 30 августа.&nbsp;
</p>
<ol><li>Вы можете работать как самостоятельно, так и в команде.&nbsp;
</li><li>Разрешено использовать абсолютно любые игровые движки.
</li><li>Игру можно делать в любом формате и на какую угодно платформу,&nbsp;однако учитывайте что её будут скачивать и оценивать люди, так что крайне желательно иметь ПК/браузерную версию.
</li><li>Можно использовать&nbsp;постороние ассеты для создания вашей игры,&nbsp;если&nbsp;у Вас есть права на них. (но,&nbsp;разумеется, чужие игры заливать на джем нельзя)
</li><li>В выложенной вами игре не должно быть NFSW(18+) контента.&nbsp;
</li><li>Не забывайте поспать и покушать :)
</li></ol>
<h2>Оценки</h2>
<p>После окончания приёма работ у Вас будет 5 дней,&nbsp;чтобы оценить&nbsp;чужие игры по следующим категориям:
</p>
<ul><li>Визуал
</li><li>Геймплей
</li><li>Оригинальность
</li><li>Соотвествие теме
</li></ul>
<p>Будут судьи, и соответственно,&nbsp;2 топа игр: по вашим оценкам (публичный рейтинг), и по оценкам судей.&nbsp;
</p>
<p>Также, будет&nbsp;2 победителя: первые&nbsp;места обоих топов. Если победитель совпадёт, судьи выберут второе место. Оба победителя получат роль в дискорде &quot;Boss of this JAM&quot;, а также ключ в стиме к моей игре &quot;Offscreen&quot;, когда она выйдет.&nbsp;
</p>
<h3>Официальные итоги будут подведены 2 сентября в 19:00</h3>
<p>Лучшие игры в джеме будут показаны в видео&nbsp;<a href="https://www.youtube.com/maxters" referrerpolicy="origin" rel="nofollow noopener"><strong>maxter</strong></a>!
</p>
<p><strong>Все игры должны создаваться в соответствии с определённой темой. Тема будет объявлена на старте джема в <a href="https://t.me/m4xter" referrerpolicy="origin" rel="nofollow noopener">тг канале</a>, ютуб сообществе и дс-сервере. </strong></p>
<p><img src="https://img.itch.zone/aW1nLzY1OTgyOTkucG5n/original/D%2Fj66N.png" loading="lazy">
</p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div tabIndex="-1" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" id="add_game_to_jam_lightbox_4302885" role="dialog"><button class="close_button"><svg aria-hidden class="svgicon icon_cross2" stroke-linecap="round" width="18" height="18" fill="none" viewBox="0 0 24 24" role="img" stroke-width="2" stroke-linejoin="round" stroke="currentColor" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a class="button" data-register_action="jam_submit" href="/login?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fmaxters-jam-2026&amp;intent=jam_submit">Log in</a><span class="or_split"> or </span><a class="button" data-register_action="jam_submit" href="/register?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fmaxters-jam-2026&amp;intent=jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_8385782', {"start_date":"2026-08-22 09:00:00","id":418750,"end_date":"2026-08-25 09:00:00","voting_end_date":"2026-08-30 09:00:00"});init_JamLayoutHeader('#jam_layout_header_2182585', {"autocomplete_props":{"ca_source":25,"ca_types":{"jam":4,"game":1,"featured_tag":7,"bundle":6,"browse_facet":8},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
