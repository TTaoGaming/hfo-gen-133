      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fgwueble-jam-2026">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fgwueble-jam-2026">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_7042693', {"start_date":"2026-07-19 19:00:00","id":417203,"end_date":"2026-07-27 00:00:00","voting_end_date":"2026-08-01 00:00:00"});init_JamLayoutHeader('#jam_layout_header_6969378', {"autocomplete_props":{"ca_source":25,"ca_types":{"bundle":6,"game":1,"featured_tag":7,"browse_facet":8,"jam":4},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
I.setup_page();</script></body></html>