      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #333132;}body{background-color: #352b30;}.jam_page_wrap{color: #e6d4be;background-color: #352b30;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #e6d4be;--itchio_border_color: #493f44;--itchio_button_color: #e6d4be;--itchio_button_fg_color: #2e2a26;--itchio_button_shadow_color: #c5b39d;--itchio_button_border_color: #c5b39d;--itchio_button_hover_color: #dbc9b3;--itchio_button_active_color: #e8d6c0;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(53, 43, 48, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px #493f44;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #52484d !important;background-color: #493f44;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #b2a8ad !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #92888d !important;}.view_jam_page .header_tabs .community_activity{background-color: #493f44;color: #e6d4be;}.view_jam_page .jam_filter_picker .filter_item{color: #92888d !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #b2a8ad !important;border-color: #e6d4be !important;}.view_jam_page .jam_filter_picker .divider{color: #b2a8ad;}@font-face {
