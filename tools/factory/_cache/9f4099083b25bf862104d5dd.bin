heme_toggle responsive" data-host="itch.io" data-page_name="view_jam"><div class="gray jam_layout_header_widget header_widget base_widget small_logo" id="jam_layout_header_476004"><a href="#maincontent" class="skip_to_main">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" href="/" title="itch.io - indie game hosting marketplace"><span class="visually_hidden">itch.io</span><img height="199" class="full_logo" src="https://static.itch.io/images/logo-black-new.svg" alt="itch.io logo &amp; title" width="775"/><img height="235" class="minimal_logo" src="https://static.itch.io/images/itchio-textless-black.svg" alt="itch.io logo" width="262"/></a></h1><div class="header_buttons"><a data-label="browse" href="/games" class="header_button browse_btn">Browse Games</a><a data-label="jams" href="/jams" class="header_button jams_btn">Game Jams</a><a data-label="developers" href="/developers" class="header_button developers_btn"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a data-label="devlogs" href="/devlogs" class="header_button devlogs_btn">Developer Logs</a><a data-label="community.home" href="/community" class="header_button community.home_btn">Community</a></div><form action="/search" class="game_search"><input required="required" class="search_input" type="text" name="q" placeholder="Search for games, jams, tags or creators"/><button aria-label="Search" class="submit_btn"><svg height="18" class="svgicon icon_search" viewBox="0 0 24 24" stroke-width="3" aria-hidden stroke-linecap="round" stroke-linejoin="round" fill="none" stroke="currentColor" version="1.1" role="img" width="18"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_8752054"><a data-label="log_in" class="panel_button" href="/login" data-register_action="header">Log in</a><a data-label="register" class="panel_button register_button" href="/register" data-register_action="header">Register</a></div></div><div class="header_dropdown" data-target="browse"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over" id="view_jam_6450165"><div class="jam_banner_outer"><img class="jam_banner full_width"/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_1199699"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/skg-jam-2026">Stop Killing Games Community Jam 2026</a></h1><div class="jam_host_header">Hosted by <a href="https://stopkillinggamescommunity.itch.io">Stop Killing Games Community</a>, <a href="https://dvh-nl.itch.io">DVH</a>, <a href="https://bigpotatoeski.itch.io">PotatoGameDev</a> · <a href="https://bsky.app/hashtag/skgjam">#skgjam</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/skg-jam-2026/entries"><div class="stat_value">334</div><div class="stat_label">Entries</div></a></div><div class="stat_box"><div class="stat_value">4,953</div><div class="stat_label">Ratings</div></div></div></div><div class="header_tabs"><a class="header_tab active" href="/jam/skg-jam-2026" data-label="tab_view_jam">Overview</a><a class="header_tab" href="/jam/skg-jam-2026/entries" data-label="tab_view_jam_entries">Submissions</a><div class="tab_group"><a class="header_tab" href="/jam/skg-jam-2026/community">Community</a><span class="community_activity">79</span></div><a class="header_tab" href="/jam/skg-jam-2026/feed" data-label="tab_view_jam_feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget after_voting is_over" id="jam_submitter_5182806"><p>This jam is now over. It ran from <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-07-17 18:00:00</span> to <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-07-24 20:00:00</span>. <a href="/jam/skg-jam-2026/entries">View 334 entries</a></p></div></div><div class="jam_content user_formatted"><h2 class="text-center"><img src="https://img.itch.zone/aW1nLzI1NTMwMzk0LnBuZw==/original/goTKPB.png" loading="lazy"></h2>
<h2></h2>
<h2>Hey, Welcome to the Stop Killing Games <strong>Community </strong>Jam 2026!</h2>
<p>This jam is created by the community surrounding the Stop Killing Games movement, by ordinary people who love the medium and care for it&#x27;s preservation. Just as the movement itself, the jam has been created by the community for the community, so please, support us by spreading the word!</p>
<h2>What&#x27;s the Theme?</h2>
<h2 class="text-center">&quot;High Score Chasers&quot;</h2>
<h2>When</h2>
<ul><li><strong>Start:</strong> Friday, July 17, 2026 @ 18:00 UTC 
</li><li><strong>Submission Deadline:</strong>&nbsp;Friday, July 24, 2026 @ 20:00 UTC 
</li><li><strong>Voting Ends:</strong> Friday, July 31, 2026 @ 20:00 UTC</li><li>Final results: Monday, August 3, 2026 @ TBA</li></ul>
<h2>What Can I Use?</h2>
<ul><li>Any engine, any style<strong>, web version required!</strong></li><li>Solo or team up to 5 participants</li><li>All skill levels welcome</li><li>Open or closed source</li></ul>
<h2> Rules</h2>
<ul><li>Your entry must follow itch.io’s Terms of Service.</li><li>No NSFW content!</li><li>You must have rights to all assets used, check licenses!</li><li>The game has to be made specifically for this jam and no other jam.</li><li>The game has to be made during the jam development period.</li><li>The game has to have a web build playable on itch!</li><li>The entry has to be a game - no assets or concepts or documents etc.</li><li>The game entry has to be playable for free.</li><li>Only one entry per person - you can be in one team only!</li><li>No harassment of real people or mocking parody.</li><li>No harassment of any other participant. There is a difference between criticism and harassment! If you feel harassed, tell the mods.</li><li>No public accusations of any sort, if something irritates you tell the organizers/discord mods. Also no speculation, bickering or prolonged arguments. Especially in game entry pages comments section! Do not blemish others.<span></span></li><li>In case of doubt ask the organizers!</li></ul>
<p><br></p>
<h2>Criteria</h2>
<p>The jam is community judged, so the submitter of every team can judge other entries.<br>Your entry will be judged by:</p>
<p>Fun - how enjoyable is your game!<br>Graphics - how nice it looks,<br>Sounds - how nice it sounds,<br>Theme relevance - how well you captured the jam theme,<br>End-of-life plan - is your game compliant with the postulates of the Stop Killing Games?<br><br>All of the criteria matter, so don&#x27;t forget to fill in the end-of-life plan field, and add some sounds :D</p>
<h2>Discord</h2>
<p>Visit our community on the jam&#x27;s discord:&nbsp;<a href="https://discord.gg/TgwS35jFyt" rel="nofollow noopener" referrerpolicy="origin">https://discord.gg/TgwS35jFyt</a><a href="https://discord.gg/ZHhKGEMh" rel="nofollow noopener" referrerpolicy="origin"><br><br></a></p>
<h2>Prizes&nbsp;</h2>
<p>This year we have prizes!</p>
<hr>
<p class="text-center"><a href="https://www.boot.dev/" target="_blank" rel="nofollow noopener" referrerpolicy="origin"><img style="width: 600px" src="https://img.itch.zone/aW1nLzI3NDQzNTcwLnBuZw==/original/FsUkgE.png" loading="lazy"></a></p>
<p><strong>Thanks to the wonderful people at <a href="https://www.boot.dev/" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Boot.dev</a>, every member of the winning team will get a 1-year membership to their platform!</strong><strong><br></strong>Additionally, everyone who submits a valid game jam entry will get a 1-month Boot.dev membership :)<br><strong>Thanks to Boot.dev for supporting our jam!</strong></p>
<hr>
<p class="text-center"><a href="https://kenney.nl/" target="_blank" rel="nofollow noopener" referrerpolicy="origin"><img style="width: 600px" src="https://img.itch.zone/aW1nLzI3NDQzNTI3LnBuZw==/original/Df0wJv.png" loading="lazy"></a><br></p>
<p><a href="https://kenney.nl/" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Kenney.nl</a>, the creator of the fantastic free graphic assets many of us use in our games has supported our jam with prizes for our winning teams!</p>
<p>Each of the top 3 teams will get:<br>3×&nbsp;<a href="https://kenney.itch.io/assetforge-deluxe" target="_blank">Asset Forge Deluxe</a><br>3×&nbsp;<a href="https://kenney.itch.io/kenney-game-assets" target="_blank">Kenney Game Assets All-in-1</a></p>
<p><strong>Thank you very much, Kenney for those wonderful prizes!<br><br></strong></p>
<hr>
<p class="text-center"><a href="https://www.aseprite.org/" target="_blank" rel="nofollow noopener" referrerpolicy="origin"><img style="width: 600px" src="https://img.itch.zone/aW1nLzI3NDQzNDIxLnBuZw==/original/0kByHq.png" loading="lazy"></a></p>
<p><a href="https://igara.com/" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Igara Studio</a>, the creators of&nbsp;<a href="https://www.aseprite.org/" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Aseprite</a>, the well-known and respected pixel art software on the indie scene, supported our jam with free codes for their great software!<br><strong>The top 3 teams will each get 3 codes for Aseprite!<br>Thank you, Igara Studio!</strong></p>
<hr>
<p class="text-center">
<a href="https://craftpix.net/?utm_source=itch.io&utm_medium=gamejam&utm_campaign=skg-jam" target="_blank" rel="nofollow noopener" referrerpolicy="origin"><img src="https://img.itch.zone/aW1nLzI4MjQwMzE2LnBuZw==/original/vjRkEQ.png" loading="lazy"></a>
<br></p>
<p><a href="https://craftpix.net/?utm_source=itch.io&utm_medium=gamejam&utm_campaign=skg-jam" target="_blank" rel="nofollow noopener" referrerpolicy="origin">CraftPix.net</a> supported us with their amazing prizes!</p>
<p><strong>Top 3 teams will get 1-year CraftPix memberships for every member (up to 5 memberships per team).</strong>&nbsp;<br><a href="https://craftpix.net/?utm_source=itch.io&utm_medium=gamejam&utm_campaign=skg-jam" target="_blank" rel="nofollow noopener" referrerpolicy="origin">CraftPix.net</a> is an online store and resource specializing in high-quality premium and free 2D game assets for game developers, indie studios, and hobbyists.<br><strong>Thank you very much, CraftPix!</strong><br></p>
<hr>
<p>✨ NEW:</p>
<p class="text-center">
<a href="https://oppalin.com/" target="_blank" rel="nofollow noopener" referrerpolicy="origin">
<img src="https://img.itch.zone/aW1nLzI4NTA0NzcyLnBuZw==/original/4tz%2BpS.png" loading="lazy"></a><br></p>
<p><a href="https://oppalin.com" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Oppalin</a> joined as a sponsor to give their nice prizes for our jammers :)</p>
<p>Oppalin is a web-based board for organizing inspiration and sketching, add images from any device, import boards from Pinterest, work by yourself or with friends and share via links.&nbsp;</p>
<p>Top 3 teams will get Oppalin memberships for every member (up to 5 memberships per team):&nbsp;</p>
<p>- 1st - 12 months of Pro Plan
<br>- 2nd - 9 months of Pro Plan
<br>- 3rd - 6 months of Pro Plan
<br>- One Lifetime License will be given to one lucky random team that uploads a valid game!&nbsp;(For one person of the team) <br>Thanks for the support, Oppalin!</p>
<p><br>
<br><br><br></p>
<p><br></p>
<p><br></p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div tabIndex="-1" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login has_fields lightbox" role="dialog" id="add_game_to_jam_lightbox_4385219"><button class="close_button"><svg height="18" class="svgicon icon_cross2" viewBox="0 0 24 24" stroke-width="2" aria-hidden stroke-linecap="round" stroke-linejoin="round" fill="none" stroke="currentColor" version="1.1" role="img" width="18"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fskg-jam-2026" data-register_action="jam_submit">Log in</a><span class="or_split"> or </span><a class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fskg-jam-2026" data-register_action="jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_6450165', {"voting_end_date":"2026-07-31 08:00:00","end_date":"2026-07-24 20:00:00","id":414076,"start_date":"2026-07-17 18:00:00"});init_JamLayoutHeader('#jam_layout_header_476004', {"autocomplete_props":{"search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"},"ca_source":25,"ca_types":{"bundle":6,"featured_tag":7,"browse_facet":8,"game":1,"jam":4},"autocomplete_url":"\/autocomplete"}});
