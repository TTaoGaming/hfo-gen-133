      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #413145;}body{background-color: #7b2d8e;}.jam_page_wrap{color: #ffffff;background-color: #7b2d8e;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #FFD700;--itchio_border_color: #8c3e9f;--itchio_button_color: #FFD700;--itchio_button_fg_color: #332b00;--itchio_button_shadow_color: #e0b800;--itchio_button_border_color: #e0b800;--itchio_button_hover_color: #f4cc00;--itchio_button_active_color: #ffd902;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(123, 45, 142, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px #8c3e9f;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #9345a6 !important;background-color: #8c3e9f;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #e496f7 !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #ca7cdd !important;}.view_jam_page .header_tabs .community_activity{background-color: #8c3e9f;color: #ffffff;}.view_jam_page .jam_filter_picker .filter_item{color: #ca7cdd !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #e496f7 !important;border-color: #FFD700 !important;}.view_jam_page .jam_filter_picker .divider{color: #e496f7;}:root {

--dark-bg: #7b2d8e;

--sunset-orange: #ff6b35;

--warm-gold: #FFD700;

--soft-white: #fff3e0;

}

.jam_content {

position: relative;

background: var(--dark-bg);

overflow: hidden;

}

.jam_content::before,

.jam_content::after {

content: '';

position: fixed;

top: 0; left: 0; right: 0; bottom: 0;

pointer-events: none;

z-index: 1;

}

.jam_content::before {

background-image:

radial-gradient(2px 2px at 60px 40px, rgba(255, 107, 53, 0.7), transparent),

radial-gradient(1px 1px at 160px 120px, rgba(255, 215, 0, 0.6), transparent),

radial-gradient(2px 2px at 320px 200px, rgba(255, 107, 53, 0.7), transparent),

radial-gradient(1px 1px at 450px 80px, rgba(255, 215, 0, 0.5), transparent),

radial-gradient(2px 2px at 550px 300px, rgba(255, 243, 224, 0.4), transparent);

background-size: 700px 700px;

animation: sparkRise 12s linear infinite;

}

.jam_content::after {

background-image:

radial-gradient(1px 1px at 100px 180px, rgba(255, 215, 0, 0.5), transparent),

radial-gradient(2px 2px at 250px 60px, rgba(255, 107, 53, 0.4), transparent),

radial-gradient(1px 1px at 400px 280px, rgba(255, 243, 224, 0.3), transparent);

background-size: 600px 600px;

animation: sparkRise 18s linear infinite;

animation-delay: -5s;

opacity: 0.5;

filter: blur(1px);

}

@keyframes sparkRise {

0% { transform: translate3d(0, 700px, 0); }

100% { transform: translate3d(0, -700px, 0); }

}

.jam_content > * {

position: relative;

z-index: 2;

}

.jam_content h2 {

color: var(--sunset-orange);

text-align: center;

text-transform: uppercase;

letter-spacing: 0.08em;

animation: orangePulse 4s ease-in-out infinite;

position: relative;

padding-bottom: 0.6em;

}

@keyframes orangePulse {

0%, 100% { text-shadow: 0 0 8px rgba(255, 107, 53, 0.3); }

50% { text-shadow: 0 0 16px rgba(255, 107, 53, 0.5), 0 0 30px rgba(255, 215, 0, 0.15); }

}

.jam_content h2::after {

content: '';

position: absolute;

bottom: 0; left: 15%; width: 70%; height: 2px;

background: linear-gradient(90deg, transparent, var(--warm-gold), var(--sunset-orange), transparent);

box-shadow: 0 0 8px rgba(255, 215, 0, 0.4);

}

.jam_content .formatted_description {

color: #cfd8dc;

}

.jam_content a {

color: var(--warm-gold);

text-decoration: none;

transition: text-shadow 0.2s ease;

}

.jam_content a:hover {

text-shadow: 0 0 8px rgba(255, 215, 0, 0.5);

}

.jam_content li {

list-style: none;

position: relative;

padding-left: 1.5em;

}

.jam_content li::before {

content: '\2022';

position: absolute;

left: 0;

color: var(--sunset-orange);

}

.jam_content strong {

color: var(--soft-white);

}

.jam_content hr {

border: none;

height: 40px;

background: none;

position: relative;

}

.jam_content hr::before {

content: '--- \2022 ---';

position: absolute;

top: 50%; left: 50%;

transform: translate(-50%, -50%);

color: var(--warm-gold);

opacity: 0.6;

} </style></head><body data-host="itch.io" class="locale_en jam_layout_widget layout_widget no_theme_toggle responsive" data-page_name="view_jam"><div class="small_logo gray jam_layout_header_widget header_widget base_widget" id="jam_layout_header_2847207"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a title="itch.io - indie game hosting marketplace" href="/" class="header_logo"><span class="visually_hidden">itch.io</span><img class="full_logo" width="775" height="199" src="https://static.itch.io/images/logo-black-new.svg" alt="itch.io logo &amp; title"/><img class="minimal_logo" width="262" height="235" src="https://static.itch.io/images/itchio-textless-black.svg" alt="itch.io logo"/></a></h1><div class="header_buttons"><a href="/games" class="header_button browse_btn" data-label="browse">Browse Games</a><a href="/jams" class="header_button jams_btn" data-label="jams">Game Jams</a><a href="/developers" class="header_button developers_btn" data-label="developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a href="/devlogs" class="header_button devlogs_btn" data-label="devlogs">Developer Logs</a><a href="/community" class="header_button community.home_btn" data-label="community.home">Community</a></div><form class="game_search" action="/search"><input placeholder="Search for games, jams, tags or creators" class="search_input" required="required" name="q" type="text"/><button aria-label="Search" class="submit_btn"><svg aria-hidden class="svgicon icon_search" stroke-linejoin="round" fill="none" viewBox="0 0 24 24" role="img" width="18" height="18" stroke="currentColor" stroke-linecap="round" stroke-width="3" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_1772810"><a href="/login" class="panel_button" data-label="log_in" data-register_action="header">Log in</a><a href="/register" class="panel_button register_button" data-label="register" data-register_action="header">Register</a></div></div><div class="header_dropdown" data-target="browse"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over has_banner" id="view_jam_2800376"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1hZ2UyL2phbS80MTY4MzAvMjc0MDE0NDkucG5n/original/GyDG%2Fn.png" class="jam_banner full_width"/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_267769"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/solo-dev-jam-12">Solo dev Jam #12</a></h1><div class="jam_host_header">Hosted by <a href="https://solodevelopment.itch.io">Solo Development</a>, <a href="https://symbol24.itch.io">symbol24</a>, <a href="https://drahmen.itch.io">drahmen</a>, <a href="https://practicalnpc.itch.io">Practical NPC</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/solo-dev-jam-12/entries"><div class="stat_value">111</div><div class="stat_label">Entries</div></a></div><div class="stat_box"><div class="stat_value">1,666</div><div class="stat_label">Ratings</div></div></div></div><div class="header_tabs"><a class="header_tab active" href="/jam/solo-dev-jam-12" data-label="tab_view_jam">Overview</a><a class="header_tab" href="/jam/solo-dev-jam-12/entries" data-label="tab_view_jam_entries">Submissions</a><a class="header_tab" href="/jam/solo-dev-jam-12/results">Results</a><div class="tab_group"><a class="header_tab" href="/jam/solo-dev-jam-12/community">Community</a><span class="community_activity">11</span></div><a class="header_tab" href="/jam/solo-dev-jam-12/feed" data-label="tab_view_jam_feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget after_voting is_over" id="jam_submitter_74739"><p>This jam is now over. It ran from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-10 19:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-13 19:00:00</span>. <a href="/jam/solo-dev-jam-12/results">View results</a></p></div></div><div class="jam_content user_formatted"><h2>Welcome to the SoloDevelopment Summer Jam!</h2>
<p><strong><a href="https://solodevelopment.org/jams" referrerpolicy="origin" rel="nofollow noopener">Link to vote</a>&nbsp;|&nbsp;<a href="https://forms.gle/6PKmdTqjEVRGqJ8YA" referrerpolicy="origin" rel="nofollow noopener">suggest themes</a>&nbsp;|&nbsp;<a href="https://discord.gg/uXeapAkAra" referrerpolicy="origin" rel="nofollow noopener">Discord</a>&nbsp;|&nbsp;<a href="https://forms.gle/cabJ58xJx1fAUYr89" referrerpolicy="origin" rel="nofollow noopener">Get featured as a streamer<br></a></strong><br></p>
<p>72 hours to turn an idea into a game. Whether you&#x27;re a regular or this is your first jam, see what you can make this weekend.</p>
<h2>Schedule:</h2>
<ul><li><strong>Start Time:</strong> July 10, 2026, 3:00 PM EDT (7:00 PM UTC)</li><li><strong>End Time:</strong> July 13, 2026, 3:00 PM EDT (7:00 PM UTC)</li><li><strong>Duration:</strong> 72 Hours</li><li><strong>Voting Period Deadline:</strong> July 18, 2026, 4:00 PM EDT (8:00 PM UTC)</li></ul>
<h2>Theme: Chain Reaction</h2><p>Theme is Chain Reaction</p>
<p><a href="https://solodevelopment.org/jams" referrerpolicy="origin" rel="nofollow noopener">Theme vote</a>&nbsp;(closed)&nbsp;|&nbsp;<a href="https://forms.gle/6PKmdTqjEVRGqJ8YA" referrerpolicy="origin" rel="nofollow noopener">suggest future themes here</a></p>
<h2>Rules:</h2>
<ul><li><strong>Solo Developers Only:</strong> This jam is just for solo devs. show off what you can do on your own.</li><li><strong>Pre-made Assets:</strong> Allowed if you have the legal rights to use them.</li><li><strong>No AI-Generated Assets:</strong> Keep the work your own.</li><li><strong>Game Engines:</strong> Use whatever you like. (Note that web builds tend to receive much more feedback)</li><li><strong>New Projects Only:</strong> Build it during the jam weekend. Old work or spam submissions will be removed.</li></ul>
<h2>Prize:</h2>
<p>The winner will receive the &quot;Jam Winner&quot; Discord role and enter our <a href="https://solodevelopment.org/showcase" referrerpolicy="origin" rel="nofollow noopener">Hall of Fame</a></p>
<h2>Judging Criteria:</h2>
<ul><li><strong>Creativity:</strong> Unique ideas or unexpected twists.</li><li><strong>Gameplay:</strong> Is it fun, interesting, or engaging?</li><li><strong>Theme Interpretation:</strong> How well the theme was used.</li><li><strong>Art:</strong>&nbsp;Visual style, cohesion, and presentation.</li><li><strong>Audio:</strong>&nbsp;Sound design, music, and how it fits the experience.</li><li><strong>Polish:</strong> Overall feel and finish of the game.</li></ul>
<h2>Community and Support:</h2>
<p>Join our <a href="https://discord.gg/uXeapAkAra" referrerpolicy="origin" rel="nofollow noopener">Discord</a> to chat with other participants, share progress, and get feedback. Explore past jams and submissions here. Mark your calendars and get ready to jam!</p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div role="dialog" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" tabIndex="-1" id="add_game_to_jam_lightbox_8246381"><button class="close_button"><svg aria-hidden class="svgicon icon_cross2" stroke-linejoin="round" fill="none" viewBox="0 0 24 24" role="img" width="18" height="18" stroke="currentColor" stroke-linecap="round" stroke-width="2" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fsolo-dev-jam-12" data-register_action="jam_submit">Log in</a><span class="or_split"> or </span><a class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fsolo-dev-jam-12" data-register_action="jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_2800376', {"end_date":"2026-07-13 19:00:00","id":416830,"start_date":"2026-07-10 19:00:00","voting_end_date":"2026-07-18 20:00:00"});init_JamLayoutHeader('#jam_layout_header_2847207', {"autocomplete_props":{"i18n":{"search":"Search","search_placeholder":"Search for games, jams, tags or creators"},"ca_source":25,"ca_types":{"jam":4,"bundle":6,"featured_tag":7,"game":1,"browse_facet":8},"autocomplete_url":"\/autocomplete","search_url":"\/search"}});
I.setup_page();</script></body></html>