      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #2c2f35;}body{background-color: #142240;}.jam_page_wrap{color: #cfd7d8;background-color: #142240;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #fa6149;--itchio_border_color: #3b4862;--itchio_button_color: #fa6149;--itchio_button_fg_color: #ffffff;--itchio_button_shadow_color: #e54c33;--itchio_button_border_color: #e54c33;--itchio_button_hover_color: #f35a41;--itchio_button_active_color: #ff664e;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(39, 52, 78, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px transparent;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #44516b !important;background-color: #3b4862;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #a1aec8 !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #828fa9 !important;}.view_jam_page .header_tabs .community_activity{background-color: #3b4862;color: #cfd7d8;}.view_jam_page .jam_filter_picker .filter_item{color: #828fa9 !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #a1aec8 !important;border-color: #fa6149 !important;}.view_jam_page .jam_filter_picker .divider{color: #a1aec8;}details {
