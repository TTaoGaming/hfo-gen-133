      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #282828;}body{background-color: #000000;}.jam_page_wrap{color: #ffffff;background-color: #000000;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #FFA700;--itchio_border_color: #191919;--itchio_button_color: #FFA700;--itchio_button_fg_color: #332100;--itchio_button_shadow_color: #e48c00;--itchio_button_border_color: #e48c00;--itchio_button_hover_color: #f69e00;--itchio_button_active_color: #ffab04;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(0, 0, 0, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px #191919;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #242424 !important;background-color: #191919;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #999999 !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #727272 !important;}.view_jam_page .header_tabs .community_activity{background-color: #191919;color: #ffffff;}.view_jam_page .jam_filter_picker .filter_item{color: #727272 !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #999999 !important;border-color: #FFA700 !important;}.view_jam_page .jam_filter_picker .divider{color: #999999;}/*Wrapper, no changes yet*/

