e-width, initial-scale=1" name="viewport"/><meta content="#FA5C5C" name="theme-color"/><meta property="og:image" content="https://img.itch.zone/aW1nLzI3MDQ1ODY4LnBuZw==/original/5r3g6k.png"/><link href="https://static.itch.io/jam.css?1785642729" rel="stylesheet"/><script type="text/javascript">window.itchio_translations_url = 'https://static.itch.io/translations';</script><script src="https://static.itch.io/lib.min.js?1785642729" type="text/javascript"></script><script src="https://static.itch.io/bundle.min.js?1785642729" type="text/javascript"></script><script data-src="https://static.itch.io/react.min.js?1785642729" id="lib_react_src"></script><script src="https://static.itch.io/jam.min.js?1785642729" type="text/javascript"></script><script type="text/javascript">I.current_user = null;</script><script type="text/javascript">if (!window.location.hostname.match(/localhost/)) {      window.dataLayer = window.dataLayer || [];
