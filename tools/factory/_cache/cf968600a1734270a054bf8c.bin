      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #402834;}body{background-color: #74003a;}.jam_page_wrap{color: #ffffff;background-color: #74003a;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #ff0280;--itchio_border_color: #8536ba;--itchio_button_color: #ff0280;--itchio_button_fg_color: #ffffff;--itchio_button_shadow_color: #f10072;--itchio_button_border_color: #f10072;--itchio_button_hover_color: #ff0a88;--itchio_button_active_color: #fa007b;background-image: url('https://img.itch.zone/aW1nLzI3NjI3NDA3LnBuZw==/original/tCuu4P.png'); background-repeat: repeat; background-position: 50% 0%; background-attachment: fixed}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(116, 37, 169, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px transparent;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #8d3ec2 !important;background-color: #8536ba;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #df90ff !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #c475f9 !important;}.view_jam_page .header_tabs .community_activity{background-color: #8536ba;color: #ffffff;}.view_jam_page .jam_filter_picker .filter_item{color: #c475f9 !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #df90ff !important;border-color: #ff0280 !important;}.view_jam_page .jam_filter_picker .divider{color: #df90ff;} </style></head><body data-page_name="view_jam" class="locale_en jam_layout_widget layout_widget responsive no_theme_toggle" data-host="itch.io"><div class="small_logo gray jam_layout_header_widget header_widget base_widget" id="jam_layout_header_2078970"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a title="itch.io - indie game hosting marketplace" href="/" class="header_logo"><span class="visually_hidden">itch.io</span><img width="775" class="full_logo" src="https://static.itch.io/images/logo-black-new.svg" alt="itch.io logo &amp; title" height="199"/><img width="262" class="minimal_logo" src="https://static.itch.io/images/itchio-textless-black.svg" alt="itch.io logo" height="235"/></a></h1><div class="header_buttons"><a href="/games" class="header_button browse_btn" data-label="browse">Browse Games</a><a href="/jams" class="header_button jams_btn" data-label="jams">Game Jams</a><a href="/developers" class="header_button developers_btn" data-label="developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a href="/devlogs" class="header_button devlogs_btn" data-label="devlogs">Developer Logs</a><a href="/community" class="header_button community.home_btn" data-label="community.home">Community</a></div><form class="game_search" action="/search"><input name="q" type="text" placeholder="Search for games, jams, tags or creators" required="required" class="search_input"/><button aria-label="Search" class="submit_btn"><svg width="18" height="18" stroke-linecap="round" aria-hidden role="img" stroke-linejoin="round" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="3" class="svgicon icon_search" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_9888507"><a data-register_action="header" href="/login" class="panel_button" data-label="log_in">Log in</a><a data-register_action="header" href="/register" class="panel_button register_button" data-label="register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over has_banner" id="view_jam_4837191"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI3NjI3MzA2LnBuZw==/original/DAv2Wq.png" class="jam_banner full_width"/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_6804236"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/game-demo-jam-i">Game Demo Jam I ($100+ in Prizes)</a></h1><div class="jam_host_header">Hosted by <a href="https://thewoodlanderslive.itch.io">The Woodlanders</a> · <a href="https://bsky.app/hashtag/GameDemoJam">#GameDemoJam</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/game-demo-jam-i/entries"><div class="stat_value">64</div><div class="stat_label">Entries</div></a></div><div class="stat_box"><div class="stat_value">449</div><div class="stat_label">Ratings</div></div></div></div><div class="header_tabs"><a class="header_tab active" href="/jam/game-demo-jam-i" data-label="tab_view_jam">Overview</a><a class="header_tab" href="/jam/game-demo-jam-i/entries" data-label="tab_view_jam_entries">Submissions</a><a class="header_tab" href="/jam/game-demo-jam-i/results">Results</a><div class="tab_group"><a class="header_tab" href="/jam/game-demo-jam-i/community">Community</a><span class="community_activity">16</span></div><a class="header_tab" href="/jam/game-demo-jam-i/feed" data-label="tab_view_jam_feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget after_voting is_over" id="jam_submitter_6922494"><p>This jam is now over. It ran from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-07 12:52:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-18 00:52:00</span>. <a href="/jam/game-demo-jam-i/results">View results</a></p></div></div><div class="jam_content user_formatted"><p><strong>🚧 Welcome to Game Demo Jam I !&nbsp;&nbsp;🚧</strong><br><br><strong>Game Demo Jam</strong> is a 10 Day Ranked Jam during which participants will polish an existing game project or create a new game project and polish it&nbsp;to the level of a game demo in just 10 days,&nbsp;There is a themed item revealed at the launch&nbsp;of the Jam that must be included in the Game Demo, but the overall genre, direction,&nbsp;and style of each Game Demo is up to the developer&#x27;s discretion!<br><br>----------------------------------------------------------<br><br><strong>🤔&nbsp;What constitutes&nbsp;a &quot;Game Demo&quot;?&nbsp;<br></strong>A Game Demo&nbsp;has both mechanics and direction.<br> <br><strong>These terms&nbsp;are described as follows:</strong></p>
<ul><li><strong>Mechanics:</strong> Rules&nbsp;and parameters by which&nbsp;a game is played. <br><em>(This means an&nbsp;empty board where players can&nbsp;run&nbsp;around is not&nbsp;a demo)</em></li></ul>
<ul><li><strong>Direction:</strong> an overarching idea that&nbsp;connects the components&nbsp;of a game&nbsp;to one&nbsp;another. <br><em>(the idea should be developed&nbsp;and easily observable)</em></li></ul>
<p>----------------------------------------------------------</p>
<p><strong>📐 Rules:</strong></p>
<ul><li><strong>NO&nbsp;AI</strong>, like none, don&#x27;t do it, just be creative :)</li></ul>
<p></p>
<p><br></p>
<ul><li><strong>NO spam submissions</strong>, devs should only submit projects they have polished during the Game Demo&nbsp;Jam I (from 7-7-2026 to 7-17-2026). <em>(This means devs&nbsp;cannot submit&nbsp;a completed project that was not worked on during the Jam period. )</em></li></ul>
<p><br></p>
<ul><li><strong>NO NSFW</strong> (nudity, <strong>18+&nbsp;</strong>content, <strong>extreme</strong> profanity,<strong>&nbsp;extreme </strong>body gore, etc., <strong>not </strong><strong>allowed</strong>)<br><em>(<strong>mild</strong> profanity, <strong>mild</strong> violence allowed)</em></li></ul>
<p><br></p>
<ul><li>Use <strong>ONLY</strong>&nbsp;assets you have&nbsp;the rights to. You may reuse any assets&nbsp;you&#x27;ve created, purchased, or have the rights to use.<br>You <strong>MUST</strong> give credits for&nbsp;all assets used. (support the creators who support you)</li></ul>
<p><br></p>
<ul><li><strong>Game must be playable in a web browser. (it&#x27;s more accessible)<br></strong></li></ul>
<p><br></p>
<ul><li>Solo Devs&nbsp;and Teams of all sizes are welcome! <br>1 cash prize per game <em>(so you have to split the $20 if your team wins 🤷‍♀️)</em><br>5 team members per winning game<span></span> will receive <span></span>1 year Craftpix subscriptions&nbsp;</li></ul>
<p>----------------------------------------------------------<br></p>
<p><strong>💭 Themed Item:&nbsp;</strong>&nbsp;with 36% of the vote Candle won! 🕯️🕯️🕯️</p>
<p>(Themed Item Voting was hosted&nbsp;on Discord, link at bottom of page)<br><br><strong>🍊 Optional Theme: </strong>Fruit&nbsp;</p>
<p>----------------------------------------------------------<br><br><strong>✍️ Judging Criteria:</strong></p>
<p>(All&nbsp;<strong>Game Demo Jam</strong> participants may score games)<br></p>
<p>The voting period is 5 days long (7-17-2026 until 7-22-2026)<br></p>
<ul><li>Visual Creativity: 1 - 5</li><li>Audio Creativity: 1 - 5</li><li>Mechanics: 1- 5</li><li>Direction: 1 - 5</li><li>Use of Themed Item: 1 - 5</li><li><strong>Overall Score</strong><strong>:</strong> Highest&nbsp;aggregated score across all&nbsp;categories</li></ul>
<p>(1 winning game per scored category, and 1 overall&nbsp;winning game, 6 total winning games)</p>
<p>----------------------------------------------------------</p>
<p><span></span></p>
<p><strong>💎 Winner&#x27;s Prizes:</strong></p>
<p>There will be 1 winning game in each scored category, and 1 overall winning game.</p>
<p>Winning games will&nbsp;receive the following:<br><br></p>
<p><strong>💎</strong><strong>&nbsp;1 year subscription to CraftPix.net!!&nbsp;</strong><br><img src="https://img.itch.zone/aW1nLzI4MjQ3ODc4LnBuZw==/original/7kf9kV.png" loading="lazy"><br>CraftPix.net is an online store and resource specializing in high-quality, premium, and free 2D game assets for game developers, indie studios, and hobbyists.<br><br>Each winning game&#x27;s participants (up to 5 team members per winning game) will receive a 1 year subscription to Craftpix.net.&nbsp;<br><a href="https://craftpix.net/?utm_source=itch.io&utm_medium=gamejam&utm_campaign=game-demo-jam" target="_blank" title="https://craftpix.net/?utm_source=itch.io&utm_medium=gamejam&utm_campaign=game-demo-jam" referrerpolicy="origin" rel="nofollow noopener">https://craftpix.net/utm_source=itch.io&utm_medium=gamejam&utm_campaign=game-demo-jam</a><a href="https://craftpix.net/" target="_blank" title="https://craftpix.net/ (https://craftpix.net/)" referrerpolicy="origin" rel="nofollow noopener"><br><br></a><br></p>
<p><strong>💎</strong>&nbsp;<strong>$20 Unity Asset Store Credit!&nbsp;</strong>
(or $20 via PayPal / Cash App )
</p>
<p><img src="https://img.itch.zone/aW1nLzI4MjQ1NDI2LnBuZw==/original/Dv%2FJDE.png" loading="lazy"><br>
</p>
<p>Each winning game will receive $20&nbsp;in&nbsp;Unity Asset Store Credits<br>or their choice of&nbsp;$20 via PayPal / Cash App&nbsp;<br><em>(so you have to split the $20 if your team wins 🤷‍♀️)&nbsp;</em><br><br><br></p>
<p><strong>💎&nbsp;</strong><strong>Top 25 Overall Score&nbsp;Game Demos will earn a spot in the<br>&quot;Game Demo&nbsp;Jam I: Top 25&quot; video on </strong><strong></strong><a href="https://www.youtube.com/@TheWoodlandersLive" referrerpolicy="origin" rel="nofollow noopener">The Woodlanders Live YouTube Channel</a>.<span></span></p>
<p>----------------------------------------------------------<br></p>
<p><strong>🎮 Discord Link:&nbsp;<a href="https://discord.gg/sWnB5fAEQ" referrerpolicy="origin" rel="nofollow noopener">https://discord.gg/sWnB5fAEQ</a></strong><br></p></div></div><div id="entries" class="grid_outer"><div class="header_row"><h2>Submissions<span class="game_count">(46)</span></h2></div><div class="jam_filter_picker"><div class="filter_item active">All submissions</div><span class="divider"> · </span><div data-filter="filter_web" class="filter_item">Browser playable (44)</div><span class="divider"> · </span><div data-filter="filter_windows" class="filter_item">Windows (11)</div><div data-filter="filter_linux" class="filter_item">Linux (2)</div><div data-filter="filter_android" class="filter_item">Android (1)</div></div><div class="jam_filter_empty"><p>No submissions match your filter</p></div><div class="game_grid_widget base_widget browse_game_grid"><div dir="auto" class="game_cell filter_html filter_windows filter_linux filter_web has_cover lazy_images" data-game_id="4003879"><div class="game_thumb"><a href="https://ludorino.itch.io/billiard-ocean" data-label="game:4003879:thumb" class="thumb_link game_link" tabindex="-1" data-action="game_grid"><img width="315" height="250" class="lazy_loaded" data-lazy_src="https://img.itch.zone/aW1nLzIzOTA3ODY5LnBuZw==/315x250%23c/8wDqxG.png"/></a><div class="game_cell_tools"><a data-register_action="add_to_collection" href="/g/ludorino/billiard-ocean/add-to-collection" class="action_btn add_to_collection_btn"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a href="https://ludorino.itch.io/billiard-ocean" data-label="game:4003879:title" data-action="game_grid" class="title game_link">Billiard Ocean</a></div><div title="Infinite Carambolage Golfing" class="game_text">Infinite Carambolage Golfing</div><div class="game_author"><a href="https://ludorino.itch.io" data-action="game_grid" data-label="user:13883895">ludorino</a></div><div c