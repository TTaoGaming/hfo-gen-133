      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #34323b;}body{background-color: #3b315e;}.jam_page_wrap{color: #ffffff;background-color: #3b315e;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #ad7c00;--itchio_border_color: #191919;--itchio_button_color: #ad7c00;--itchio_button_fg_color: #ffffff;--itchio_button_shadow_color: #9a6900;--itchio_button_border_color: #9a6900;--itchio_button_hover_color: #b38206;--itchio_button_active_color: #a67500;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(0, 0, 0, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px transparent;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #242424 !important;background-color: #191919;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #999999 !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #727272 !important;}.view_jam_page .header_tabs .community_activity{background-color: #191919;color: #ffffff;}.view_jam_page .jam_filter_picker .filter_item{color: #727272 !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #999999 !important;border-color: #ad7c00 !important;}.view_jam_page .jam_filter_picker .divider{color: #999999;}:root{
  --primary: #8e1f25;
  --secondary: #c93a2f;
  --accent: #f1c46b;
  --accent2: #e79a3b;
  --ink: #09070b;
  --paper: #f5e7cc;
  --border: rgba(241, 196, 107, 0.72);
  --border2: rgba(241, 196, 107, 0.22);
  --shadow: 0 16px 36px rgba(0,0,0,0.5);
  --glow: 0 0 14px rgba(241, 196, 107, 0.14);
}

p{
  font-size: 1.15em;
  line-height: 1.6;
  color: var(--paper);
}

a{
  font-weight: 900;
  color: var(--paper);
  text-decoration: none;
  transition: color 0.2s ease, filter 0.2s ease, text-shadow 0.2s ease;
}

.view_jam_page a:hover{
  color: var(--accent);
  text-shadow: 0 0 8px rgba(241, 196, 107, 0.22);
}

a.custom-dark{
  font-family: 'Lilita One', sans-serif;
  font-size: 1.1em;
  text-align: center;
  font-weight: 900;
  letter-spacing: 0.02em;
  background-image: linear-gradient(to bottom, #ffe4a8, var(--accent) 58%, var(--accent2) 100%);
  color: transparent;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-stroke: 0.0015em var(--ink);
  text-shadow: 0 2px 0 rgba(0,0,0,0.32);
}

a.custom-dark:hover{
  filter: brightness(1.08);
}

.custom-theme{
  text-align: center;
  margin: 20px 0 10px 0;
}

.custom-theme p{
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 0.008em;
  text-transform: uppercase;
  font-size: 0.9em;
  margin-bottom: -1.0em;
  opacity: 0.9;
}

.custom-theme .custom-header{
  margin-top: 0;

}
.custom-theme h2{
  color: var(--paper);
  margin-top: -0.9em;
  font-weight: 600;
  letter-spacing: 0.04em;
}

h2.custom-header{
  font-family: 'Lilita One', sans-serif;
  font-size: 3.5em;
  text-align: center;
  font-weight: 900;
  letter-spacing: 0.02em;
  background-image:
    linear-gradient(to bottom,
      #fff2c7 0%,
      #f7d98b 22%,
      var(--accent) 52%,
      var(--accent2) 82%,
      #9d4f1f 100%);
