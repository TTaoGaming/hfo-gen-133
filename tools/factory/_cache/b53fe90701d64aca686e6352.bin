      rgba(0,0,0,0.18) 100%),
    radial-gradient(circle at 50% 0%, rgba(241, 196, 107, 0.08) 0%, transparent 26%);
}

.view_jam_page .jam_body{
  margin-top: 0px;
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(to bottom,
      rgba(76, 18, 24, 0.30) 0%,
      rgba(26, 14, 20, 0.94) 10%,
      rgba(12, 9, 13, 0.97) 40%,
      rgba(8, 6, 10, 0.99) 100%);
