      rgba(18, 10, 15, 0.96) 60%,
      rgba(46, 18, 22, 0.96) 100%) !important;
  color: var(--paper);
  border-radius: 0 0 10px 10px !important;
  padding: 15px !important;
  margin-top: -10px;
