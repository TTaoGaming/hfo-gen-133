.jam_page_wrap {

	.view_jam_page .jam_body {
		background: none;
		box-shadow: none;

		.jam_header_widget.base_widget {
			margin:2em;
			background: none;
			padding: 0;
			border-bottom: none;
			position: relative;
			display: grid;
			grid-template-areas: "title stats" "spacer stats";
			grid-template-columns: auto 1fr;
			grid-template-rows: auto 1fr;
			min-height: 600px;

			.header_inner {
				width: 100%;
				height: 100%;
				display: contents;
			}

			.header_columns {
				border-radius: 8px;
				grid-area: 1 / 1 / -1 / -1;
				background-image: url("https://img.itch.zone/aW1nLzI0Nzc1MjE2LnBuZw==/original/h9h0kP.png");
				background-size: 55%;
				background-position: bottom right;
				background-repeat: no-repeat;
				position: relative;
			}

			.title_colum .jam_title_header,
			.jam_host_header,
			.stats_container {
				background-color: rgba(28, 28, 28, 0.85);
				border-radius: 8px;
				padding: 0.25em;
				color: #fff;
			}

			.title_colum .jam_title_header {
				grid-area: title;
				align-self: start;
				justify-self: start;
				font-family: "Audiowide", serif !important;
				font-size: 65px;
				margin: 0.25em;
				max-width: 250px;
			}

			.jam_host_header {
				padding-left: 0.5em;
				padding-right: 0.5em;
				position: absolute;
				bottom: 0;
				left: 0;
				margin: 1.1em;
			}

			.stats_container {
				grid-area: stats;
				align-self: end;
				justify-self: end;
				margin-bottom: 1em;
				margin-right: -0.8em;

				.stat_box {
					margin-left: 0.5em;
					margin-right: 0.5em;
				}
			}

			.stat_value {
				font-family: "Audiowide", serif !important;
			}

			.header_tabs {
				position: relative;
				margin-top: 1.5em;
				margin: 1em;
				z-index: 1;
				padding: 0.5em;

				padding-left: 1em;
				padding-right: 1em;
				background-color: rgba(28, 28, 28, 0.85);
				border-radius: 8px;
			}
		}

		.jam_submitter_widget.base_widget {
			.block_value {
				font-family: "Audiowide", serif !important;
			}

			.button.fat.submitter_button.join_jam_btn:hover {
				transition: box-shadow 0.5s;
				box-shadow: 0 0 10px #e5166e;
			}

			padding: 20px;
			margin: 2em;
width:89%;
		}

		@media screen and (max-width: 920px) {
			.jam_submitter_widget.base_widget {
				width: 80%;
			}
		}

		@media screen and (max-width: 700px) {
			.jam_submitter_widget.base_widget {
				min-width: 40%;
			}


		}

		@media screen and (max-width: 650px) {
			.jam_header_widget.base_widget {
				.stats_container {
					display: block;
				}

				.title_colum .jam_title_header {
					font-size: 60px;
				}

				.stats_container {
					margin-bottom: 5em;
					grid-area: none;
					position: absolute;
					bottom: 0;
					left: 0;
				}
			}
		}



		.submitter_outer {
			margin-top: 0.5em;
			margin-bottom: 0.5em;
		}

		.submitter_outer .jam_submitter_widget.base_widget,
		.jam_content.user_formatted {
			margin-top: 0.5em;
			margin-left:3em;
			position: relative;
			border-style: none;
			padding: 20px;
			border-radius: 8px;
			z-index: 1;
			background-color: rgba(28, 28, 28, 0.85);

			h1 {
				span {
					font-family: "Audiowide", serif !important;
				}
			}
		}

		.jam_content.user_formatted hr {
			background: linear-gradient(45deg,
					rgba(28, 28, 28, 0) 10%,
					rgb(77, 178, 179) 25%,
					rgb(179, 77, 178) 50%,
					rgb(178, 179, 77) 75%,
					rgba(28, 28, 28, 0) 90%);
			height: 4px;
			border: none;
			border-radius: 8px;
			background-position: 0 50%;
			max-width: 75%;
		}

		.jam_content.user_formatted::before,
		.jam_submitter_widget.base_widget::before,
		.header_tabs::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: -1;
			border-radius: 8px;
			padding: 4px;
			background: linear-gradient(45deg,
					rgb(77, 178, 179) 0%,
					rgb(179, 77, 178) 50%,
					rgb(178, 179, 77) 100%);
			-webkit-mask:
				linear-gradient(#fff 0 0) content-box,
				linear-gradient(#fff 0 0);
			mask:
				linear-gradient(#fff 0 0) content-box,
				linear-gradient(#fff 0 0);
			-webkit-mask-composite: xor;
			mask-composite: exclude;
		}
	}
}

