      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #28292f;}body{background-color: #000223;}.jam_page_wrap{color: #ffd502;background-color: #000223;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 111%;--itchio_border_radius: 30px;--itchio_link_color: #fe0c13;--itchio_border_color: #311818;--itchio_button_color: #fe0c13;--itchio_button_fg_color: #ffffff;--itchio_button_shadow_color: #f10006;--itchio_button_border_color: #f10006;--itchio_button_hover_color: #ff141b;--itchio_button_active_color: #f9070e;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(25, 0, 0, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px transparent, 0 0 24px rgba(254, 12, 19, 0.9);}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #3c2323 !important;background-color: #311818;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #ad9494 !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #886f6f !important;}.view_jam_page .header_tabs .community_activity{background-color: #311818;color: #ffd502;}.view_jam_page .jam_filter_picker .filter_item{color: #886f6f !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #ad9494 !important;border-color: #fe0c13 !important;}.view_jam_page .jam_filter_picker .divider{color: #ad9494;} </style></head><body data-host="itch.io" class="locale_en jam_layout_widget layout_widget responsive no_theme_toggle" data-page_name="view_jam"><div class="small_logo gray jam_layout_header_widget header_widget base_widget" id="jam_layout_header_344296"><a href="#maincontent" class="skip_to_main">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" href="/" title="itch.io - indie game hosting marketplace"><span class="visually_hidden">itch.io</span><img class="full_logo" width="775" alt="itch.io logo &amp; title" src="https://static.itch.io/images/logo-black-new.svg" height="199"/><img class="minimal_logo" width="262" alt="itch.io logo" src="https://static.itch.io/images/itchio-textless-black.svg" height="235"/></a></h1><div class="header_buttons"><a class="header_button browse_btn" href="/games" data-label="browse">Browse Games</a><a class="header_button jams_btn" href="/jams" data-label="jams">Game Jams</a><a class="header_button developers_btn" href="/developers" data-label="developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a class="header_button devlogs_btn" href="/devlogs" data-label="devlogs">Developer Logs</a><a class="header_button community.home_btn" href="/community" data-label="community.home">Community</a></div><form class="game_search" action="/search"><input name="q" type="text" placeholder="Search for games, jams, tags or creators" required="required" class="search_input"/><button aria-label="Search" class="submit_btn"><svg role="img" class="svgicon icon_search" viewBox="0 0 24 24" width="18" height="18" stroke-width="3" stroke-linecap="round" aria-hidden fill="none" stroke="currentColor" stroke-linejoin="round" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_1315975"><a data-register_action="header" class="panel_button" href="/login" data-label="log_in">Log in</a><a data-register_action="header" class="panel_button register_button" href="/register" data-label="register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default during_submit has_banner" id="view_jam_8375869"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI4MDAyNjA4LnBuZw==/original/K%2Bh2Zd.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_5485684"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/hps1-summer-camp-jam">Haunted PS1 Summer Camp Jam</a></h1><div class="jam_host_header">Hosted by <a href="https://vladimerelhore.itch.io">VladimereLhore</a></div></div><div class="stats_container"><div class="stat_box"><div class="stat_value">276</div><div class="stat_label">Joined</div></div><div class="stat_box"><a href="/jam/hps1-summer-camp-jam/entries"><div class="stat_value">2</div><div class="stat_label">Entries</div></a></div></div></div><div class="header_tabs"><a class="header_tab active" href="/jam/hps1-summer-camp-jam" data-label="tab_view_jam">Overview</a><a class="header_tab" href="/jam/hps1-summer-camp-jam/entries" data-label="tab_view_jam_entries">Submissions</a><div class="tab_group"><a class="header_tab" href="/jam/hps1-summer-camp-jam/community">Community</a><span class="community_activity">11</span></div><a class="header_tab" href="/jam/hps1-summer-camp-jam/feed" data-label="tab_view_jam_feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget during_submit" id="jam_submitter_3016695"><div class="date_data">Submissions open from <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-07-27 08:00:00</span> to <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-08-24 08:00:00</span></div><div class="countdown"><span class="countdown_label">Submissions due in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button data-href="/jam/417714/join" class="button fat submitter_button join_jam_btn" data-method="post">Join jam</button></div></div></div><div class="jam_content user_formatted"><p>Gather around the fire and spin a yarn for all to enjoy this communal development season!&nbsp;</p>
<p>The jam&#x27;s primary theme is<strong> <em>CAMP</em></strong>, from outdoor recreations to aesthetic stylings. Lose yourself to the great outdoors, fill those lungs with mountain air! Enjoy being over the top and absolutely absurd! Live for the melodrama, live for toasted marshmallows.</p><p>Please try to keep your initial scope small, something you can build&nbsp;with in a week or two. While the jam may run for a month, we don&#x27;t want you&nbsp;working on it with all the free time you can muster during that month.&nbsp;<br><br>If you&#x27;re not already in the HPS1 discord server, consider joining us!<br>Show off your progress! Find a team of devs to work with! Just hang out!</p>
<p><a target="_blank" href="https://discord.gg/cNcu2eWRpX" referrerpolicy="origin" rel="nofollow noopener">Join the Haunted PS1 discord!</a>&nbsp;</p>
<p>Rules :&nbsp;
</p>
<ol><li>No genAI.</li><li>Only use assets you have the legal right to use.</li><li>Your game doesn&#x27;t have to be PS1 accurate. Any retro aesthetic choices count. (Low Poly, Pixel art, CRT effect, etc)&nbsp;
</li><li>Take it easy! This is just for fun!</li></ol></div></div><div id="entries" class="grid_outer"><div class="header_row"><h2>Submitted so far<span class="game_count">(2)</span></h2></div><div class="jam_filter_picker"><div class="filter_item active">All submissions</div><span class="divider"> · </span><div data-filter="filter_web" class="filter_item">Browser playable (1)</div><span class="divider"> · </span><div data-filter="filter_windows" class="filter_item">Windows (1)</div><div data-filter="filter_osx" class="filter_item">macOS (1)</div><div data-filter="filter_linux" class="filter_item">Linux (1)</div></div><div class="jam_filter_empty"><p>No submissions match your filter</p></div><div class="game_grid_widget base_widget browse_game_grid"><div dir="auto" data-game_id="4780944" class="game_cell filter_html filter_web has_cover lazy_images"><div class="game_thumb"><a class="thumb_link game_link" tabindex="-1" data-action="game_grid" href="https://littlegouwei498.itch.io/climb-serene-peak" data-label="game:4780944:thumb"><img class="lazy_loaded" width="315" data-lazy_src="https://img.itch.zone/aW1nLzI4NzI2NzQxLmpwZw==/315x250%23c/XgHLPh.jpg" height="250"/></a><div class="game_cell_tools"><a data-register_action="add_to_collection" class="action_btn add_to_collection_btn" href="/g/littlegouwei498/climb-serene-peak/add-to-collection"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a class="title game_link" data-action="game_grid" href="https://littlegouwei498.itch.io/climb-serene-peak" data-label="game:4780944:title">Climb · Every step counts</a></div><div title="An addicting idle climber game featuring beautiful 3D mountain views" class="game_text">An addicting idle climber game featuring beautiful 3D mountain views</div><div class="game_author"><a data-action="game_grid" data-label="user:18252061" href="https://littlegouwei498.itch.io">littlegouwei498</a></div><div class="game_genre">Adventure</div><div class="game_platform"><span class="web_flag">Play in browser</span></div></div></div><div dir="auto" data-game_id="4251856" class="game_cell filter_windows filter_osx filter_linux has_cover lazy_images"><div style="background-color:#198a97;" class="game_thumb"><a class="thumb_link game_link" tabindex="-1" data-action="game_grid" href="https://profgoggles.itch.io/a-shroud-of-rime" data-label="game:4251856:thumb"><img class="lazy_loaded" width="315" data-lazy_src="https://img.itch.zone/aW1nLzI1MzMwODA0LnBuZw==/315x250%23c/%2BMAmgx.png" height="250"/></a><div class="game_cell_tools"><a data-register_action="add_to_collection" class="action_btn add_to_collection_btn" href="/g/profgoggles/a-shroud-of-rime/add-to-collection"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a class="title game_link" data-action="game_grid" href="https://profgoggles.itch.io/a-shroud-of-rime" data-label="game:4251856:title">a shroud of rime</a></div><div title="four vignettes for unfortunate times" class="game_text">four vignettes for unfortunate times</div><div class="game_author"><a data-action="game_grid" data-label="user:172785" href="https://profgoggles.itch.io">Joan</a></div><div class="game_genre">Visual Novel</div><div class="game_platform"><span aria-hidden="true" title="Download for Windows" class="icon icon-windows8"></span> <span aria-hidden="true" title="Download for Linux" class="icon icon-tux"></span> <span aria-hidden="true" title="Download for macOS" class="icon icon-apple"></span> </div></div></div></div><div class="itch_footer"><span class="powerd_by">powered by</span><a title="itch.io" href="/"><img alt="" class="header_logo" src="https://static.itch.io/images/logo-black-new.svg" height="30"/></a></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div role="dialog" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" id="add_game_to_jam_lightbox_4263132" tabIndex="-1"><button class="close_button"><svg role="img" class="svgicon icon_cross2" viewBox="0 0 24 24" width="18" height="18" stroke-width="2" stroke-linecap="round" aria-hidden fill="none" stroke="currentColor" stroke-linejoin="round" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a href="http://itch.io" target="_blank">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fhps1-summer-camp-jam">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fhps1-summer-camp-jam">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_8375869', {"id":417714,"start_date":"2026-07-27 08:00:00","end_date":"2026-08-24 08:00:00"});init_JamLayoutHeader('#jam_layout_header_344296', {"autocomplete_props":{"i18n":{"search":"Search","search_placeholder":"Search for games, jams, tags or creators"},"ca_source":25,"ca_types":{"game":1,"browse_facet":8,"featured_tag":7,"jam":4,"bundle":6},"autocomplete_url":"\/autocomplete","search_url":"\/search"}});
