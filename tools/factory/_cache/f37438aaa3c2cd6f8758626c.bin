      }</script><style type="text/css" id="jam_theme">:root{--itchio_ui_bg: #302847;}body{background-color: #27009b;}.jam_page_wrap{color: #ffffff;background-color: #27009b;font-family: Lato,Lato,LatoExtended,sans-serif;font-size: 100%;--itchio_border_radius: initial;--itchio_link_color: #c11294;--itchio_border_color: #3d16b1;--itchio_button_color: #c11294;--itchio_button_fg_color: #ffffff;--itchio_button_shadow_color: #b40587;--itchio_button_border_color: #b40587;--itchio_button_hover_color: #c91a9c;--itchio_button_active_color: #bc0d8f;}.jam_body{border-radius: var(--itchio_border_radius,0);}.view_jam_page h1,.view_jam_page h2,.view_jam_page h3,.view_jam_page h4,.view_jam_page h5,.view_jam_page h6{}.view_jam_page .jam_body,.view_jam_page .grid_outer{background-color: rgba(39, 0, 155, 1);}.view_jam_page .jam_body{box-shadow: 0 0 0 2px #3d16b1;}.view_jam_page .grid_outer .itch_footer{border-top: 1px solid #4720bb !important;background-color: #3d16b1;}.view_jam_page .game_grid_widget .game_cell .game_text,.view_jam_page .grid_outer .game_count,.view_jam_page .grid_outer .footer_submissions{color: #ae87ff !important;}.view_jam_page .game_grid_widget .game_cell .game_platform,.view_jam_page .game_grid_widget .game_cell .game_genre,.view_jam_page .game_grid_widget .game_cell .game_author a,.view_jam_page .grid_outer .powerd_by{color: #8c65ff !important;}.view_jam_page .header_tabs .community_activity{background-color: #3d16b1;color: #ffffff;}.view_jam_page .jam_filter_picker .filter_item{color: #8c65ff !important;}.view_jam_page .jam_filter_picker .filter_item:hover,.view_jam_page .jam_filter_picker .filter_item.active{color: #ae87ff !important;border-color: #c11294 !important;}.view_jam_page .jam_filter_picker .divider{color: #ae87ff;} </style></head><body class="locale_en jam_layout_widget layout_widget no_theme_toggle responsive" data-host="itch.io" data-page_name="view_jam"><div class="gray jam_layout_header_widget header_widget base_widget small_logo" id="jam_layout_header_8131443"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" title="itch.io - indie game hosting marketplace" href="/"><span class="visually_hidden">itch.io</span><img class="full_logo" alt="itch.io logo &amp; title" src="https://static.itch.io/images/logo-black-new.svg" height="199" width="775"/><img class="minimal_logo" alt="itch.io logo" src="https://static.itch.io/images/itchio-textless-black.svg" height="235" width="262"/></a></h1><div class="header_buttons"><a class="header_button browse_btn" data-label="browse" href="/games">Browse Games</a><a class="header_button jams_btn" data-label="jams" href="/jams">Game Jams</a><a class="header_button developers_btn" data-label="developers" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a class="header_button devlogs_btn" data-label="devlogs" href="/devlogs">Developer Logs</a><a class="header_button community.home_btn" data-label="community.home" href="/community">Community</a></div><form class="game_search" action="/search"><input required="required" class="search_input" type="text" name="q" placeholder="Search for games, jams, tags or creators"/><button aria-label="Search" class="submit_btn"><svg role="img" viewBox="0 0 24 24" width="18" height="18" stroke-width="3" stroke-linecap="round" aria-hidden stroke-linejoin="round" stroke="currentColor" fill="none" class="svgicon icon_search" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_1083788"><a data-label="log_in" data-register_action="header" class="panel_button" href="/login">Log in</a><a data-label="register" data-register_action="header" class="panel_button register_button" href="/register">Register</a></div></div><div class="header_dropdown" data-target="browse"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over has_banner" id="view_jam_9921250"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI4NDk1OTc2LnBuZw==/original/AWbyAm.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_6545955"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/astrocade-never-seen-it-jam">Astrocade | Never Seen It Before Jam</a></h1><div class="jam_host_header">Hosted by <a href="https://playastrocade.itch.io">PlayAstrocade</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/astrocade-never-seen-it-jam/entries"><div class="stat_value">128</div><div class="stat_label">Entries</div></a></div></div></div><div class="header_tabs"><a class="header_tab active" data-label="tab_view_jam" href="/jam/astrocade-never-seen-it-jam">Overview</a><a class="header_tab" data-label="tab_view_jam_entries" href="/jam/astrocade-never-seen-it-jam/entries">Submissions</a><div class="tab_group"><a class="header_tab" href="/jam/astrocade-never-seen-it-jam/community">Community</a><span class="community_activity">8</span></div><a class="header_tab" data-label="tab_view_jam_feed" href="/jam/astrocade-never-seen-it-jam/feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget after_voting is_over" id="jam_submitter_7829138"><p>This jam is now over. It ran from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-17 13:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-08-01 06:59:00</span>. <a href="/jam/astrocade-never-seen-it-jam/entries">View 128 entries</a></p></div></div><div class="jam_content user_formatted"><h1>Rules</h1>
<p>- MUST use <strong><a href="https://www.astrocade.com/create" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Astrocade [ONLY]</a></strong> for game creation
- MUST submit <strong>only 1 game per creator</strong>&nbsp;
<br>
- To enter the competition, you&#x27;ll have to give feedback/ upvote to at least 3 participants in our <a href="https://discord.gg/mcFTnbCVk5" target="_blank" referrerpolicy="origin" rel="nofollow noopener">private discord</a>.
<br>
- MUST work on mobile and desktop (no bugs) [will be eliminated if it&#x27;s buggy]<br></p>
<h1>Theme</h1>
<p><strong>“Never seen before”</strong></p>
<p>Make something nobody has ever played or interacted before. A toy, an instrument, a game, a weird musical thing, a place to hang out, a machine that does something pointless but beautiful, and so on. It just has to be an interactive experience and it has to be new, thats all. </p><p>If it makes us go &quot;wait, what IS this,&quot; you got it right.</p>
<p>🧠 <strong>Get SUPER creative</strong> <br>🕹️ <strong>Any genre welcome (keep it hyper casual/ casual)&nbsp;</strong>
</p>
<h1>Prize</h1>
<p>Winners will be announced <strong>5</strong><strong>th</strong><strong> Aug 2026</strong><strong> on Astrocade Discord </strong>(please join our discord for prize collection and announcement)
</p>
<p><strong>1st prize:</strong> $400&nbsp; |&nbsp;&nbsp;<strong>2nd prize:</strong> $200 | <strong>3rd prize:</strong> $100&nbsp;&nbsp;
</p>
<p><strong>4th, 5th, 6th, 7th Prize: </strong>$40 each <strong>8th, 9th, 10th Prize: </strong>$30 each
</p>
<h1>How to Enter?</h1>
<p><strong>👾 Join Our Discord</strong>
</p>
<p>- All submissions should be in <a href="https://discord.gg/mcFTnbCVk5" target="_blank" referrerpolicy="origin" rel="nofollow noopener">#game-showcase channel on Astrocade Discord</a> with the tag &quot;never-seen jam 👀&quot;
</p>
<h1>Judging</h1>
<p>- Games that pass QA (not buggy) will be hosted top Astrocade feed for millions to play
<br>
- Top 20 games will be chosen based on how well it performs on the feed (Player engagement time)&nbsp;
<br>
- Top 20 games will be judged by Astrocade&#x27;s in-house Experienced Game Developers&nbsp;
</p>
<p>&nbsp;&nbsp;<strong>Criteria:</strong>
<br>
1. Creativity/uniqueness&nbsp;
<br>
2. Fun/addictive
<br>
3. Quality (polish, feel, UI)
</p>
<h1>Tutorial</h1>
<p>For both new and existing Astrocade users, check out these tutorials to level up your game-making skills&mdash;and boost your chances of claiming the top spot!&nbsp;&nbsp;<a href="https://astroblox.notion.site/Astro-Academy-2fc6eca6308f80089491c65f7fb605e8?source=copy_link" target="_blank" title="https://astroblox.notion.site/Astro-Academy-2fc6eca6308f80089491c65f7fb605e8?source=copy_link" referrerpolicy="origin" rel="nofollow noopener">https://astroblox.notion.site/Astro-Academy-2fc6eca6308f80089491c65f7fb605e8?source=copy_link</a>
<br><br>
<strong><em>Good luck and happy creating!!</em></strong>
</p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div tabIndex="-1" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" role="dialog" id="add_game_to_jam_lightbox_4405709"><button class="close_button"><svg role="img" viewBox="0 0 24 24" width="18" height="18" stroke-width="2" stroke-linecap="round" aria-hidden stroke-linejoin="round" stroke="currentColor" fill="none" class="svgicon icon_cross2" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fastrocade-never-seen-it-jam">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fastrocade-never-seen-it-jam">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_9921250', {"id":418343,"end_date":"2026-08-01 06:59:00","start_date":"2026-07-17 13:00:00"});init_JamLayoutHeader('#jam_layout_header_8131443', {"autocomplete_props":{"search_url":"\/search","ca_source":25,"autocomplete_url":"\/autocomplete","ca_types":{"browse_facet":8,"jam":4,"game":1,"featured_tag":7,"bundle":6},"i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
