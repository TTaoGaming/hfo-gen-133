/* Colour tokens */
:root {
  --bg-base: #D4DEDD;                        /* pale teal-grey — page background */
  --body-color: #FFFFFF;                     /* white content box */
  --accent: #000000;                         /* black — links/text */
  --accent-hover: #1eace9;                   /* dusty-teal hover */
  --accent-glow: rgba(143, 176, 183, 0.3);   /* dusty-teal glow */
  --accent-ring: #1eace9;                    /* dusty-teal hover ring */
  --divider: #9AA8A8;                        /* teal-grey divider */
  --divider-strong: rgba(154, 168, 168, 0.1);
  --divider-subtle: rgba(154, 168, 168, 0.05);
  --faq-hover-bg: rgba(212, 222, 221, 0.2);  /* teal-grey tint */
  --faq-border-hover: #8FB0B7;               /* dusty-teal */
  --shadow-light: rgba(0, 0, 0, 0.05);
  --shadow-med: rgba(0, 0, 0, 0.1);
  --shadow-heavy: rgba(0, 0, 0, 0.18);
}
body {
  min-height: 100vh;
}
.jam_page_wrap {
  background-color: var(--bg-base);
}
.view_jam_page {
  font-family: 'Montserrat', sans-serif;
  color: #000000 !important;
}
/* Main content box */
.view_jam_page .jam_body {
  background-color: var(--body-color);
  box-shadow: 0 2px 8px var(--shadow-heavy);
  transition: box-shadow 0.25s ease;
  text-align: center;
  border-radius: 32px;
  animation: bodyPulse 0.8s ease-out;
  margin-bottom: 80px;
}
/* This fixes the color separation/split */
.view_jam_page .jam_content {
  background-color: transparent !important;
}
.view_jam_page .header_tabs .community_activity {
  background-color: #000000;
  color: #D4DEDD;
}
@keyframes bodyPulse {
  0% { transform: scale(0.98); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
/* The hover ring */
.view_jam_page .jam_body:hover {
  box-shadow: 0 4px 16px var(--shadow-light), 0 0 0 5px var(--accent-ring);
}
/* Global Dark Text Enforcement */
.view_jam_page h1, .view_jam_page h2, .view_jam_page h3, 
.view_jam_page p, .view_jam_page li, .view_jam_page summary,
.view_jam_page .stat_value, .view_jam_page .stat_label {
  color: #000000 !important;
}
/* Custom title */
.view_jam_page .jam_header_widget .jam_title_header {
  font-size: 0;
  font-weight: 900;
  margin: 20px 0;
  display: block !important;
  position: relative;
  color: #000000 !important;
}
.view_jam_page .jam_header_widget .jam_title_header::before {
  content: 'Micro Jam 062:';
  display: block;
  font-size: 24px;
  font-weight: 300;
  line-height: 1.2;
}
.view_jam_page .jam_header_widget .jam_title_header::after {
  content: 'SPEED';
  display: block;
  font-size: 112px;
  font-weight: 1000;
  line-height: 1;
  margin-top: 4px;
  letter-spacing: 12px;
}
/* Links */
.view_jam_page a {
  text-decoration: underline;
  color: #000000;
  transition: all 0.3s ease;
  display: inline-block;
}
.view_jam_page a:hover {
  color: var(--accent-hover);
  transform: translateY(-2px);
  text-shadow: 0 0 12px var(--accent-glow);
}
/* Images */
.view_jam_page .user_formatted img,
.view_jam_page img {
  max-width: 100%;
  border: 0;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
/* Tabs */
.view_jam_page .header_tabs .header_tab.active,
.view_jam_page .header_tabs .header_tab:hover {
  opacity: 1;
  color: #000000;
  border-bottom: 4px solid var(--accent-hover);
}
.view_jam_page .header_tabs .tab_group>.header_tab {
  margin-right: 0;
  color: #000000;
}
/* FAQ parent container */
.view_jam_page > details,
.view_jam_page .jam_content > details {
  margin-bottom: 48px;
  border: 2px solid #000000;
  border-radius: 32px;
  padding: 0px;
  transition: all 0.25s ease;
}
.view_jam_page > details:hover,
.view_jam_page .jam_content > details:hover {
  border-color: var(--accent-hover);
  transform: translateY(-2px);
}
/* Mobile */
@media (max-width: 768px) {
  .view_jam_page .jam_header_widget .jam_title_header::after {
    font-size: 64px;
    letter-spacing: 6px;
  }
  .view_jam_page .jam_body {
    border-radius: 20px;
  }
} </style></head><body data-page_name="view_jam" class="locale_en jam_layout_widget layout_widget responsive no_theme_toggle" data-host="itch.io"><div class="gray jam_layout_header_widget header_widget base_widget small_logo" id="jam_layout_header_864014"><a href="#maincontent" class="skip_to_main">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a href="/" class="header_logo" title="itch.io - indie game hosting marketplace"><span class="visually_hidden">itch.io</span><img class="full_logo" alt="itch.io logo &amp; title" height="199" width="775" src="https://static.itch.io/images/logo-black-new.svg"/><img class="minimal_logo" alt="itch.io logo" height="235" width="262" src="https://static.itch.io/images/itchio-textless-black.svg"/></a></h1><div class="header_buttons"><a data-label="browse" class="header_button browse_btn" href="/games">Browse Games</a><a data-label="jams" class="header_button jams_btn" href="/jams">Game Jams</a><a data-label="developers" class="header_button developers_btn" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a data-label="devlogs" class="header_button devlogs_btn" href="/devlogs">Developer Logs</a><a data-label="community.home" class="header_button community.home_btn" href="/community">Community</a></div><form action="/search" class="game_search"><input name="q" type="text" placeholder="Search for games, jams, tags or creators" required="required" class="search_input"/><button aria-label="Search" class="submit_btn"><svg stroke-width="3" stroke-linecap="round" width="18" height="18" stroke="currentColor" stroke-linejoin="round" fill="none" aria-hidden role="img" class="svgicon icon_search" viewBox="0 0 24 24" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_9727204"><a data-label="log_in" cla