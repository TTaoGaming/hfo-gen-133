      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fmini-guy-music-fight&amp;intent=jam_submit">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fmini-guy-music-fight&amp;intent=jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_1147921', {"start_date":"2026-07-16 18:00:00","id":418256,"voting_end_date":"2026-07-30 18:00:00","end_date":"2026-07-24 03:59:59"});init_JamLayoutHeader('#jam_layout_header_7973748', {"autocomplete_props":{"ca_source":25,"ca_types":{"featured_tag":7,"browse_facet":8,"jam":4,"bundle":6,"game":1},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
