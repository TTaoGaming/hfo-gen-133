layout_widget layout_widget responsive no_theme_toggle" data-host="itch.io"><div class="small_logo gray jam_layout_header_widget header_widget base_widget" id="jam_layout_header_9686390"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a title="itch.io - indie game hosting marketplace" href="/" class="header_logo"><span class="visually_hidden">itch.io</span><img width="775" class="full_logo" src="https://static.itch.io/images/logo-black-new.svg" alt="itch.io logo &amp; title" height="199"/><img width="262" class="minimal_logo" src="https://static.itch.io/images/itchio-textless-black.svg" alt="itch.io logo" height="235"/></a></h1><div class="header_buttons"><a href="/games" class="header_button browse_btn" data-label="browse">Browse Games</a><a href="/jams" class="header_button jams_btn" data-label="jams">Game Jams</a><a href="/developers" class="header_button developers_btn" data-label="developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a href="/devlogs" class="header_button devlogs_btn" data-label="devlogs">Developer Logs</a><a href="/community" class="header_button community.home_btn" data-label="community.home">Community</a></div><form class="game_search" action="/search"><input name="q" type="text" placeholder="Search for games, jams, tags or creators" required="required" class="search_input"/><button aria-label="Search" class="submit_btn"><svg width="18" height="18" stroke-linecap="round" aria-hidden role="img" stroke-linejoin="round" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="3" class="svgicon icon_search" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_3663571"><a data-register_action="header" href="/login" class="panel_button" data-label="log_in">Log in</a><a data-register_action="header" href="/register" class="panel_button register_button" data-label="register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default during_submit has_banner" id="view_jam_5904886"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1hZ2UyL2phbS80MTUyMzAvMjYzMjE3NjkucG5n/original/PLu0pd.png" class="jam_banner full_width"/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_4149483"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/the-queer-wrongs-jam-2026">The Queer Wrongs Jam 2026</a></h1><div class="jam_host_header">Hosted by <a href="https://caedestyles.itch.io">caede styles</a> · <a href="https://bsky.app/hashtag/QueerWrongsJam2026">#QueerWrongsJam2026</a></div></div><div class="stats_container"><div class="stat_box"><div class="stat_value">437</div><div class="stat_label">Joined</div></div><div class="stat_box"><a href="/jam/the-queer-wrongs-jam-2026/entries"><div class="stat_value">121</div><div class="stat_label">Entries</div></a></div></div></div><div class="header_tabs"><a class="header_tab active" href="/jam/the-queer-wrongs-jam-2026" data-label="tab_view_jam">Overview</a><a class="header_tab" href="/jam/the-queer-wrongs-jam-2026/entries" data-label="tab_view_jam_entries">Submissions</a><div class="tab_group"><a class="header_tab" href="/jam/the-queer-wrongs-jam-2026/community">Community</a><span class="community_activity">24</span></div><a class="header_tab" href="/jam/the-queer-wrongs-jam-2026/feed" data-label="tab_view_jam_feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget during_submit" id="jam_submitter_5618017"><div class="date_data">Submissions open from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-06-01 04:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-09-01 03:59:59</span></div><div class="countdown"><span class="countdown_label">Submissions due in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button class="button fat submitter_button join_jam_btn" data-href="/jam/415230/join" data-method="post">Join jam</button></div></div></div><div class="jam_content user_formatted"><p class="text-center"><strong>🔞&nbsp;This jam is for mature audiences only. Projects may</strong><strong>&nbsp;contain adult content and/or disturbing themes.&nbsp;🪦🕊️</strong></p>
<p><strong>Gay rights! Trans rights!</strong>&nbsp;<strong>Queer rights!</strong> This jam believes in those. But this jam also believes in <em>wrongs</em>. Even the most &quot;inoffensive&quot; queer&nbsp;media has&nbsp;been getting policed and censored from all sides - <em>fuck that</em>. This event aims to celebrate&nbsp;stories that feature&nbsp;queer characters who are &quot;bad&quot; in some way, from regular people who make mistakes to&nbsp;quirky villains to morally bankrupt&nbsp;murderers.</p>
<p><strong>This is an unranked jam in which &quot;winning&quot; is&nbsp;to be unapologetic, to refuse to&nbsp;censor our artistic expression, and to reject having to always make our existence&nbsp;&quot;palatable&quot; and squeaky-clean.</strong></p>
<p><strong>🎮 What can I&nbsp;submit? 📚</strong><br>- Stories that <strong>majorly feature queer characters</strong> that fit the theme (free, paid, or PWYW)<br>- Stories <strong>created</strong>, <strong>first released</strong>, or <strong>given a major update</strong> <strong>in 2026</strong>: you can start early<strong>&nbsp;</strong>or work during the jam period to make something new or finish a WIP, or even submit something you already made this year<br>- <strong>Any medium:</strong> games, novels, comics, audio dramas, TTRPGs, etc.<br>- <strong>Multiple submissions</strong> are allowed. Additionally, this jam is non-exclusive and also welcomes work submitted to other jams.<br>- <strong>Original work only.</strong> No fan work for this jam.<br>- <strong>Human-made work only.</strong> Absolutely no genAI whatsoever.</p>
<p>Both <strong>solo creators </strong>and <strong>teams&nbsp;</strong>are welcome, just make sure everyone is credited on the project page! If you&#x27;re looking for collaborators, you can make a post in the Community tab.</p>
<p><strong>🏳️‍🌈&nbsp;What qualifies as &quot;queer&quot;? Do I need to be queer myself? 🏳️‍⚧️</strong><br>If it&#x27;s a queer story to you, it probably is. From the &quot;classic&quot; LGBT to microlabels, it&#x27;s all on-topic. You do not need to be of any specific identity, nor do you need to disclose such information.<br><br><strong>😈 What qualifies as &quot;wrong&quot;? 🔪</strong><br>Anything you think fits. A queer character who has to deal with the consequences of hurting a loved one can be&nbsp;just as on-topic as a quirky mad scientist performing a little questionable science or completely irredeemable cannibal serial killers. You can have lighthearted vigilantes or go balls to the wall insane. Have fun.</p>
<p><strong>😱 But there&#x27;s a submission&nbsp;with ICKY subjects like</strong><strong>--</strong><br>I don&#x27;t care.</p>
<p><strong>🌟&nbsp;Is there a theme? / Can I get some inspiration? 🪄</strong><br>You do NOT have to follow a theme. But if you&#x27;d <em>like </em>one: give us some <em>magic</em>! Both because it&#x27;s fun and because of the various reasons that we could always use more stories featuring magic that don&#x27;t harm queer people. Y&#x27;know? :)</p>
<p><strong>💰 Is there going to be a related bundle?</strong><br>Yes, probably even more than one throughout the rest of the year, depending on the amount of entries and interested creators. Please stay tuned.</p>
<p>If you&#x27;d like to host a specific themed bundle (such as &quot;Sapphic Wrongs&quot;, &quot;Ace Wrongs&quot;, etc.) but don&#x27;t know where to start or need&nbsp;a helping hand, go <a target="_blank" href="https://caedestyles.wordpress.com/2026/03/28/how-to-host-a-successful-itch-io-co-op-bundle/" referrerpolicy="origin" rel="nofollow noopener">check out my guide to hosting a&nbsp;bundle</a> and/or&nbsp;contact me (see below)!</p>
<p class="text-center">☆</p>
<p>I&#x27;m looking forward to everyone&#x27;s entries!&nbsp;<strong>If you have any questions,</strong> feel free to make a post in the Community tab, or reach out to me via email (caede@sanctuary17223.com) or <a href="https://bsky.app/profile/caede.sanctuary17223.com" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Bluesky</a>.</p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div role="dialog" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" tabIndex="-1" id="add_game_to_jam_lightbox_6832558"><button class="close_button"><svg width="18" height="18" stroke-linecap="round" aria-hidden role="img" stroke-linejoin="round" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" class="svgicon icon_cross2" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fthe-queer-wrongs-jam-2026">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fthe-queer-wrongs-jam-2026">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_5904886', {"end_date":"2026-09-01 03:59:59","id":415230,"start_date":"2026-06-01 04:00:00"});init_JamLayoutHeader('#jam_layout_header_9686390', {"autocomplete_props":{"ca_source":25,"ca_types":{"featured_tag":7,"browse_facet":8,"jam":4,"game":1,"bundle":6},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
I.setup_page();</script></body></html>