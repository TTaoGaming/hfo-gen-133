yout_header_3027628"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" title="itch.io - indie game hosting marketplace" href="/"><span class="visually_hidden">itch.io</span><img alt="itch.io logo &amp; title" class="full_logo" src="https://static.itch.io/images/logo-black-new.svg" height="199" width="775"/><img alt="itch.io logo" class="minimal_logo" src="https://static.itch.io/images/itchio-textless-black.svg" height="235" width="262"/></a></h1><div class="header_buttons"><a data-label="browse" class="header_button browse_btn" href="/games">Browse Games</a><a data-label="jams" class="header_button jams_btn" href="/jams">Game Jams</a><a data-label="developers" class="header_button developers_btn" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a data-label="devlogs" class="header_button devlogs_btn" href="/devlogs">Developer Logs</a><a data-label="community.home" class="header_button community.home_btn" href="/community">Community</a></div><form class="game_search" action="/search"><input required="required" class="search_input" type="text" name="q" placeholder="Search for games, jams, tags or creators"/><button aria-label="Search" class="submit_btn"><svg stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden stroke-width="3" fill="none" role="img" stroke="currentColor" viewBox="0 0 24 24" class="svgicon icon_search" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_6158103"><a data-register_action="header" class="panel_button" data-label="log_in" href="/login">Log in</a><a data-register_action="header" class="panel_button register_button" data-label="register" href="/register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default during_submit has_banner" id="view_jam_3152540"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1nLzI4NDE5NDU0LnBuZw==/original/zBSkL9.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_1625713"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/takernalgamejam2026">Takernal Game Jam 2026</a></h1><div class="jam_host_header">Hosted by <a href="https://takernal-community.itch.io">Takernal Community</a>, <a href="https://ddulla.itch.io">DDULLA</a>, <a href="https://yoinzar.itch.io">Yoinzar</a></div></div><div class="stats_container"><div class="stat_box"><div class="stat_value">343</div><div class="stat_label">Joined</div></div><div class="stat_box"><a href="/jam/takernalgamejam2026/entries"><div class="stat_value">1</div><div class="stat_label">Entries</div></a></div></div></div><div class="header_tabs"><a data-label="tab_view_jam" class="header_tab active" href="/jam/takernalgamejam2026">Overview</a><a data-label="tab_view_jam_entries" class="header_tab" href="/jam/takernalgamejam2026/entries">Submissions</a><div class="tab_group"><a class="header_tab" href="/jam/takernalgamejam2026/community">Community</a><span class="community_activity">6</span></div><a data-label="tab_view_jam_feed" class="header_tab" href="/jam/takernalgamejam2026/feed">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget during_submit" id="jam_submitter_9602598"><div class="date_data">Submissions open from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-08-01 18:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-08-10 04:59:59</span></div><div class="countdown"><span class="countdown_label">Submissions due in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button data-method="post" class="button fat submitter_button join_jam_btn" data-href="/jam/418189/join">Join jam</button></div></div></div><div class="jam_content user_formatted"><p>Welcome to Takernal Game Jam 2026</p>
<p>Welcome to Takernal Game Jam 2026, an international game development competition that brings together students, professionals, and independent developers from around the world to create a video game within a limited time.</p>
<p>The event will take place from August 1–9, 2026, and will be held entirely online through Discord and itch.io.<br></p><p><img src="https://img.itch.zone/aW1nLzI4OTk3NTY1LnBuZw==/original/eBwNNo.png" loading="lazy"><br></p><p><br></p>
<p><img src="https://img.itch.zone/aW1nLzI4NDM1NzM0LnBuZw==/original/MqoXyd.png" loading="lazy"><br></p>
<p><span></span></p>
<ul><li>🎉 Opening Ceremony &mdash; August 1, 2026 (Hybrid – Peru &amp; Live Stream)&nbsp;</li><li>🎮 Game Development &mdash; August 1–9, 2026 (Online)</li><li>⏰ Submission Deadline &mdash; August 9, 2026</li><li>🏆 Awards Ceremony &mdash; September 12, 2026 (Hybrid – Peru &amp; Live Stream)</li></ul>
<p class="text-center">Watch live: <a href="https://www.youtube.com/@TakernalCommunity" referrerpolicy="origin" rel="nofollow noopener">https://www.youtube.com/@TakernalCommunity</a></p>
<p class="text-center"><span></span></p>
<p class="text-center"><img src="https://img.itch.zone/aW1nLzI4NDM1NzUyLnBuZw==/original/LhveLk.png" loading="lazy"></p>
<p>Everyone is welcome!</p>
<p>Whether you are a:</p>
<ul><li>💻 Programmer</li><li>🎮 Game Designer</li><li>🎨 Artist</li><li>🎼 Music Composer</li><li>🔊 Sound Designer</li><li>✍️ Writer</li><li>🎬 Animator</li></ul>
<p>You can participate individually or in teams of up to 5 members.<br></p>
<p><img src="https://img.itch.zone/aW1nLzI4NDM1NzY4LnBuZw==/original/Zo3JGv.png" loading="lazy"><br></p>
<ul><li>Best Gameplay Mechanics &mdash; USD $100</li><li>Best Art &mdash; USD $100</li><li>Best Music &mdash; USD $100</li><li>Best Narrative &mdash; USD $100</li><li>Best Use of Theme &mdash; USD $100</li></ul>
<p>🎮 In addition, five Unity Pro licenses will be awarded, with one license for each winning team.</p>
<p><img src="https://img.itch.zone/aW1nLzI4NDM1Nzc5LnBuZw==/original/ib3s%2F7.png" loading="lazy"><br></p>
<p>1. Join our <a href="https://discord.gg/Rr3umGFnXX" referrerpolicy="origin" rel="nofollow noopener">Discord server</a>.</p>
<p>2. Register for Takernal Game Jam 2026 on itch.io.</p>
<p>3. If you want to compete for prizes, register your team using the official registration form, available starting August 1.</p>
<p>Please note: Only registered teams will be eligible for judging and prizes.<span></span></p>
<p><img src="https://img.itch.zone/aW1nLzI4NDM1Nzk2LnBuZw==/original/EEbRqh.png" loading="lazy"><br></p>
<p></p>
<p>Your submission must include:</p>
<ul><li>A playable version of your game.</li><li>A game description.</li><li>At least one screenshot.</li><li>Game controls.</li><li>Team member information.</li><li>Credits for any third-party assets used.</li></ul>
<p>Good luck, have fun, and enjoy the jam!</p>
<p>🚀 See you at Takernal Game Jam 2026!</p>
<p>
</p>
<p><img src="https://img.itch.zone/aW1nLzI4OTYyMjM1LnBuZw==/original/1oexhm.png" loading="lazy"><br></p>
<p><br></p></div></div><div id="entries" class="grid_outer"><div class="header_row"><h2>Submitted so far<span class="game_count">(1)</span></h2></div><div class="jam_filter_picker"><div class="filter_item active">All submissions</div></div><div class="jam_filter_empty"><p>No submissions match your filter</p></div><div class="game_grid_widget base_widget browse_game_grid"><div dir="auto" class="game_cell has_cover lazy_images" data-game_id="4808775"><div style="background-color:#743f39;" class="game_thumb"><a tabindex="-1" class="thumb_link game_link" href="https://zeorge.itch.io/dont-run-gold-coins" data-label="game:4808775:thumb" data-action="game_grid"><img class="lazy_loaded" width="315" height="250" data-lazy_src="https://img.itch.zone/aW1nLzI4NjgxNTEzLnBuZw==/315x250%23c/kyUKSC.png"/></a><div class="game_cell_tools"><a class="action_btn add_to_collection_btn" data-register_action="add_to_collection" href="/g/zeorge/dont-run-gold-coins/add-to-collection"><span class="icon icon-playlist_add"></span>Add to collection</a></div></div><div class="game_cell_data"><div class="game_title"><a class="title game_link" href="https://zeorge.itch.io/dont-run-gold-coins" data-label="game:4808775:title" data-action="game_grid">Don&#039;t Run Gold Coins</a></div><div title="An Addictive Incremental Game" class="game_text">An Addictive Incremental Game</div><div class="game_author"><a data-action="game_grid" data-label="user:17511588" href="https://zeorge.itch.io">Zeorge</a></div><div class="game_genre">Strategy</div></div></div></div><div class="itch_footer"><span class="powerd_by">powered by</span><a title="itch.io" href="/"><img alt="" height="30" src="https://static.itch.io/images/logo-black-new.svg" class="header_logo"/></a></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div id="add_game_to_jam_lightbox_4083259" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login lightbox" tabIndex="-1" role="dialog"><button class="close_button"><svg stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden stroke-width="2" fill="none" role="img" stroke="currentColor" viewBox="0 0 24 24" class="svgicon icon_cross2" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a data-register_action="jam_submit" class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Ftakernalgamejam2026">Log in</a><span class="or_split"> or </span><a data-register_action="jam_submit" class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Ftakernalgamejam2026">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_3152540', {"voting_end_date":"2026-08-30 04:59:00","id":418189,"start_date":"2026-08-01 18:00:00","end_date":"2026-08-10 04:59:59"});init_JamLayoutHeader('#jam_layout_header_3027628', {"autocomplete_props":{"ca_source":25,"ca_types":{"game":1,"featured_tag":7,"browse_facet":8,"jam":4,"bundle":6},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
