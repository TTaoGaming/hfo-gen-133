ut_widget layout_widget responsive no_theme_toggle" data-host="itch.io"><div class="jam_layout_header_widget header_widget base_widget small_logo gray" id="jam_layout_header_9855053"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a title="itch.io - indie game hosting marketplace" class="header_logo" href="/"><span class="visually_hidden">itch.io</span><img class="full_logo" src="https://static.itch.io/images/logo-black-new.svg" height="199" width="775" alt="itch.io logo &amp; title"/><img class="minimal_logo" src="https://static.itch.io/images/itchio-textless-black.svg" height="235" width="262" alt="itch.io logo"/></a></h1><div class="header_buttons"><a class="header_button browse_btn" data-label="browse" href="/games">Browse Games</a><a class="header_button jams_btn" data-label="jams" href="/jams">Game Jams</a><a class="header_button developers_btn" data-label="developers" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a class="header_button devlogs_btn" data-label="devlogs" href="/devlogs">Developer Logs</a><a class="header_button community.home_btn" data-label="community.home" href="/community">Community</a></div><form class="game_search" action="/search"><input class="search_input" type="text" required="required" name="q" placeholder="Search for games, jams, tags or creators"/><button aria-label="Search" class="submit_btn"><svg viewBox="0 0 24 24" class="svgicon icon_search" stroke-width="3" aria-hidden stroke-linecap="round" stroke-linejoin="round" fill="none" stroke="currentColor" width="18" height="18" role="img" version="1.1"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_581511"><a data-label="log_in" class="panel_button" data-register_action="header" href="/login">Log in</a><a data-label="register" class="panel_button register_button" data-register_action="header" href="/register">Register</a></div></div><div data-target="browse" class="header_dropdown"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default before_start has_banner" id="view_jam_6946920"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1hZ2UyL2phbS80MDkyMDMvMjYwMDIzMzcucG5n/original/%2FpWGI9.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_6670114"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/brackeys-16">Brackeys Game Jam 2026.2</a></h1><div class="jam_host_header">Hosted by <a href="https://brackeysgames.itch.io">Brackeys</a>, <a href="https://aquaxv.itch.io">AquaXV</a>, <a href="https://oliverbooth.itch.io">Yasahiro</a>, <a href="https://duxez.itch.io">Duxez</a> · <a href="https://bsky.app/hashtag/BrackeysGameJam">#BrackeysGameJam</a></div></div><div class="stats_container"><div title="11,517" class="stat_box"><div class="stat_value">11.5k</div><div class="stat_label">Joined</div></div></div></div><div class="header_tabs"><a class="header_tab active" data-label="tab_view_jam" href="/jam/brackeys-16">Overview</a><div class="tab_group"><a class="header_tab" href="/jam/brackeys-16/community">Community</a><span class="community_activity">193</span></div></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget before_start" id="jam_submitter_1569907"><div class="date_data">Submissions open from <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-08-23 10:00:00</span> to <span class="date_format" data-format="MMMM Do YYYY [at] h:mm A">2026-08-30 10:00:00</span></div><div class="countdown"><span class="countdown_label">Starts in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button data-method="post" data-href="/jam/409203/join" class="button fat submitter_button join_jam_btn">Join jam</button></div></div></div><div class="jam_content user_formatted"><p><img src="https://img.itch.zone/aW1nLzI2MDAyNDY2LnBuZw==/original/Es%2F7yq.png" loading="lazy"><span></span>
</p>
<h1>3... 2... 1 week to make a game! 🕹️</h1>
<p>The Brackeys Game Jam runs twice a year and is a fun way to try out ideas, meet other devs and talk about your games and their progress. And of course the best part is that in the end you will have made and finished a game that you can share with your friends, family and fellow developers.
</p>
<p>The game you make must be based on the jam theme which is announced when the jam starts. After the jam is over your game will get rated on by other participants and you will get to vote on other games.
</p>
<h1>But what if I&#x27;m new? 🫠</h1>
<p>Give it a shot anyway! It&#x27;s worth a try and you&#x27;ll probably learn a lot! In fact we&#x27;ve made a video specifically on <a href="https://youtu.be/d_NA_yTXOOQ" target="_blank" referrerpolicy="origin" rel="nofollow noopener">how to get ready for your first game jam</a>! Even if you don&#x27;t finish in time, you can&#x27;t ask for a better way to practice.
</p>
<h1>Can I team up? 🤝</h1>
<p>Teams are allowed and encouraged! Visit the <em>jam_find_a_team</em> channel on <a href="https://discord.gg/brackeys" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Discord</a> to find someone to team up with. We recommend that you keep your team under 4 members; It can be hard to coordinate more in just a week. Other than what we recommend, there is no team size restriction.
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNTUyLnBuZw==/original/f%2FzXcn.png" loading="lazy">
</p>
<h1>Theme voting is open!</h1>
<h3><a href="https://forms.gle/FXj4YtYqBntZTEs29" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Vote now</a>&nbsp;on your favorite themes.</h3>
<p>The winning theme will be announced when the jam starts.
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjMyLnBuZw==/original/nuNy3r.png" loading="lazy">
</p>
<figure><a href="https://developer.crazygames.com/" target="_blank" referrerpolicy="origin" rel="nofollow noopener"><img src="https://img.itch.zone/aW1nLzIwMDMyOTUxLnBuZw==/original/NCcI6B.png" loading="lazy"></a></figure>
<h4>🚀 Bring Your Web Game to Millions with CrazyGames!&nbsp; 🚀</h4>
<p><em><a href="https://www.crazygames.com/" target="_blank" referrerpolicy="origin" rel="nofollow noopener">CrazyGames.com</a> is the ultimate platform for web games, reaching millions of players worldwide and we&#x27;re passionate about supporting new developers and game jam creators! </em><em>Our seamless integration, monetization tools, and real player feedback make it easy to get your game online, refine it and start earning from your creations.</em>
</p>
<p><em>&nbsp;<a href="https://developer.crazygames.com/" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Get started today</a> and bring your game to life!</em>
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjAwLnBuZw==/original/V935rb.png" loading="lazy">
</p>
<p><strong>✅ Be friendly</strong> and respectful of others.
</p>
<p><strong>✅ Host on Itch</strong>. No links to external downloads.
</p>
<p><strong>✅ Teaming up is allowed</strong>. See above.
</p>
<p><strong>✅ Use any engine or framework</strong>. You can also use assets not made by you, but make sure you have the proper license to use them and crediting is of course encouraged.
</p>
<p><strong>✅ Your game must be mostly original. </strong>Making everything from scratch is not mandatory, but if you do you get to be extra proud of yourself at the end!
</p>
<p><strong>✅ Follow the Itch.io TOS</strong>.
</p>
<p><strong>❌ No AI-Generated content</strong>.
</p>
<p><strong>❌ No NSFW or offensive content</strong>.
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjA0LnBuZw==/original/kgbGsp.png" loading="lazy">
</p>
<h3>This is very important: Leave proper time to submit your game. 🚀</h3>
<p>The jam does <strong>NOT</strong> include a grace period for people who didn&#x27;t get their game properly submitted before time.
</p>
<p>We recommend creating the Itch Page and uploading your game <strong>AT LEAST</strong> a couple of hours in advance. These things take time so make sure to plan for it.
</p>
<p>Game files are not locked for the first 48 hours of the rating period. This is for fixing bugs and adding alternative platform support. Don&#x27;t use this feature to otherwise update your game. After the rating period is over, if you wish to continue working on your game, please keep the original jam version as an alternative download.
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjA2LnBuZw==/original/XtnVsD.png" loading="lazy">
</p>
<p>The games will be rated in 6 categories:&nbsp;
</p>
<h3><strong>Enjoyment 💜 Gameplay 💜 Innovation 💜 Theme 💜 Visuals 💜 Audio.</strong></h3>
<p>This is a wide variety of game dev aspects, so don&#x27;t worry if you can&#x27;t hit all of them perfectly. Try to get creative and stick to the theme though!
</p>
<p>After the submission period is over, you&#x27;ll have two weeks to rate games. Only submitters can vote. Your game needs to have at least 20 ratings to be eligible to win, so make sure to play a lot of games, so your own game has a higher chance of being shown to others!
</p>
<p>🏆 The winning entry, decided by the best score over all categories will earn the honor of being the overall winner of the Brackeys Game Jam and the fancy Discord role to go with it. But don&#x27;t let not winning discourage you! It&#x27;s a game jam, so participation is what it&#x27;s all about!
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjA3LnBuZw==/original/4QKl4%2F.png" loading="lazy">
</p>
<p>- Anything you make during the Brackeys Game Jam is your property. Brackeys claims no rights or ownership of your game.&nbsp;
</p>
<p>- Any submission to the Brackeys Game Jam (including the game, Itch page, artwork etc.) may be used in a Brackeys YouTube video, thumbnail and on the Brackeys social media channels including but not limited to the Brackeys Facebook, Twitter and Discord without your express permission.
</p>
<p>- We reserve the right to disqualify or remove any submission from the competition.
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjQ3LnBuZw==/original/3jw9ws.png" loading="lazy">
</p>
<p>The Brackeys Game Jam is organized by Brackeys in collaboration with the Brackeys Community. Thanks to moderators AquaXV, Job and Yasahiro for helping host it.
</p>
<p>🖌️ The art for this jam is based on the art submission by Lara.
</p>
<p><img src="https://img.itch.zone/aW1nLzI2MDAyNjA5LnBuZw==/original/T%2F6QKE.png" loading="lazy">
</p>
<p>As always we wish all of you the best of luck with your games and most importantly; make sure to have fun! 😄
</p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div id="add_game_to_jam_lightbox_2773954" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login has_fields lightbox" role="dialog" tabIndex="-1"><button class="close_button"><svg viewBox="0 0 24 24" class="svgicon icon_cross2" stroke-width="2" aria-hidden stroke-linecap="round" stroke-linejoin="round" fill="none" stroke="currentColor" width="18" height="18" role="img" version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a class="button" data-register_action="jam_submit" href="/login?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fbrackeys-16&amp;intent=jam_submit">Log in</a><span class="or_split"> or </span><a class="button" data-register_action="jam_submit" href="/register?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fbrackeys-16&amp;intent=jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_6946920', {"start_date":"2026-08-23 10:00:00","id":409203,"end_date":"2026-08-30 10:00:00","voting_end_date":"2026-09-13 10:00:00"});init_JamLayoutHeader('#jam_layout_header_9855053', {"autocomplete_props":{"ca_types":{"browse_facet":8,"game":1,"bundle":6,"jam":4,"featured_tag":7},"autocomplete_url":"\/autocomplete","search_url":"\/search","i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"},"ca_source":25}});
I.setup_page();</script></body></html>