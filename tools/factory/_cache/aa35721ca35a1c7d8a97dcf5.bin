m_layout_header_5265364"><a class="skip_to_main" href="#maincontent">Skip to main content</a><div class="primary_header"><h1 title="itch.io - indie game hosting marketplace" class="title"><a class="header_logo" title="itch.io - indie game hosting marketplace" href="/"><span class="visually_hidden">itch.io</span><img class="full_logo" alt="itch.io logo &amp; title" src="https://static.itch.io/images/logo-black-new.svg" height="199" width="775"/><img class="minimal_logo" alt="itch.io logo" src="https://static.itch.io/images/itchio-textless-black.svg" height="235" width="262"/></a></h1><div class="header_buttons"><a class="header_button browse_btn" data-label="browse" href="/games">Browse Games</a><a class="header_button jams_btn" data-label="jams" href="/jams">Game Jams</a><a class="header_button developers_btn" data-label="developers" href="/developers"><span aria-hidden="true" class="icon icon-upload"></span>Upload Game</a><a class="header_button devlogs_btn" data-label="devlogs" href="/devlogs">Developer Logs</a><a class="header_button community.home_btn" data-label="community.home" href="/community">Community</a></div><form class="game_search" action="/search"><input placeholder="Search for games, jams, tags or creators" class="search_input" required="required" name="q" type="text"/><button aria-label="Search" class="submit_btn"><svg class="svgicon icon_search" stroke="currentColor" width="18" height="18" stroke-linecap="round" stroke-linejoin="round" aria-hidden fill="none" stroke-width="3" version="1.1" viewBox="0 0 24 24" role="img"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></button></form><div class="user_panel_widget base_widget" id="user_panel_4331165"><a data-label="log_in" class="panel_button" data-register_action="header" href="/login">Log in</a><a data-label="register" class="panel_button register_button" data-register_action="header" href="/register">Register</a></div></div><div class="header_dropdown" data-target="browse"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default during_submit has_banner" id="view_jam_2760276"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1hZ2UyL2phbS80MTQwNDIvMjY4NDEzOTgucG5n/original/ulyQTR.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_7515658"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/climate-jam-2026">Climate Jam 2026: Plant a seed!</a></h1><div class="jam_host_header">Hosted by <a href="https://indiecade.itch.io">IndieCade</a> · <a href="https://bsky.app/hashtag/climatejam">#climatejam</a></div></div><div class="stats_container"><div class="stat_box"><div class="stat_value">319</div><div class="stat_label">Joined</div></div></div></div><div class="header_tabs"><a class="header_tab active" data-label="tab_view_jam" href="/jam/climate-jam-2026">Overview</a><div class="tab_group"><a class="header_tab" href="/jam/climate-jam-2026/community">Community</a><span class="community_activity">17</span></div></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget during_submit" id="jam_submitter_4675432"><div class="date_data">Submissions open from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-01 17:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-08-12 06:59:59</span></div><div class="countdown"><span class="countdown_label">Submissions due in</span><div class="times"><div data-name="years" class="time_block"><div class="block_value"></div><div class="block_label">years</div></div><div data-name="months" class="time_block"><div class="block_value"></div><div class="block_label">months</div></div><div data-name="days" class="time_block"><div class="block_value"></div><div class="block_label">days</div></div><div data-name="hours" class="time_block"><div class="block_value"></div><div class="block_label">hours</div></div><div data-name="minutes" class="time_block"><div class="block_value"></div><div class="block_label">minutes</div></div><div data-name="seconds" class="time_block"><div class="block_value"></div><div class="block_label">seconds</div></div></div></div><div class="state_action"><button data-href="/jam/414042/join" class="button fat submitter_button join_jam_btn" data-method="post">Join jam</button></div></div></div><div class="jam_content user_formatted"><p><strong>SPRINT 4 INSTRUCTIONS</strong><br>In this final sprint you will prepare to &quot;release&quot; your game.</p>
<p>The Sprint 4 Milestones are:</p>
<ol><li>Create promotional materials and upgrade your project page.</li><li>Prepare your final submission.</li><li>Polish your build (do not add new features!).</li><li>(Optional) Stretch Goals</li></ol>
<p><a target="_blank" href="https://www.indiecade.com/climate-jam-2026/sprint-4/" referrerpolicy="origin" rel="nofollow noopener">Refer to the the Sprint 4 Milestones page for full instructions.</a><span></span></p>
<hr>
<p><strong>OVERVIEW</strong><br>Climate Jam is an annual six-week online game jam where developers from around the world create games that inspire action for our changing planet.</p>
<p>Build a small, polished, releasable game that explores environmental challenges and climate solutions while connecting with a global community!
</p>
<p><a href="https://www.indiecade.com/climate-jam-2026/" referrerpolicy="origin" rel="nofollow noopener">Learn more on the IndieCade website</a>.
</p>
<hr>
<p><strong>GAME TOPICS &amp; THEMES</strong><br>We&#x27;re looking for games that explore climate change and environmental issues through evidence-based solutions and meaningful calls to action.</p>
<p>This year&#x27;s featured theme is &quot;<strong>Plant a Seed!</strong>&quot;
</p>
<p>Need inspiration? Browse of the past Climate Jam projects to see the wide variety of ideas, genres, and approaches from previous participants.<br><a href="https://itch.io/jam/climate-jam-2025/entries">2025 Submissions<br></a><a href="https://itch.io/jam/climate-jam-2024/entries">2024 Submissions</a></p>
<hr>
<p><strong>JAM STRUCTURE</strong><br>Climate Jam follows the Greenlight Jam format, guiding participants through four development sprints towards a releasable final project.&nbsp;Each sprint has a <em>challenge</em>&nbsp;with specific deliverables to submit at the end of the sprint.</p>
<p>Participants are encouraged to follow the sprint schedule, submit materials for each challenge, and provide feedback on the other projects as they are developed.</p>
<hr>
<p><strong>SCHEDULE</strong><strong style=""></strong><br><em>All deadlines listed below are in Pacific Daylight Time (PDT).</em></p>
<p><strong>Sprint 1: <a href="https://itch.io/jam/climate-jam-2026-sprint-1" target="_blank">Ideation</a></strong><br>Brainstorm, research, prototype, and define your game&#x27;s core concept.<strong></strong><br> July 1: Jam Kickoff &amp; Sprint 1 Begins (10:00am PDT)<br> July 6: Sprint 1 Deadline (11:59pm PDT)<br> July 7: Review &amp; Feedback Period</p>
<p><strong>Sprint 2: <a target="_blank" href="https://itch.io/jam/climate-jam-2026-sprint-2">Pre-Production</a></strong><br>Continue prototyping, build a proof of concept, refine your design, and create a production plan.<strong></strong><br> July 8: Sprint 2 Begins (10:00am PDT)<br> July 13: Sprint 2 Deadline (11:59pm PDT)<br> July 14: Review &amp; Feedback Period</p>
<p><strong>Sprint 3: <a href="https://itch.io/jam/climate-jam-2026-sprint-3" target="_blank">Full Production</a></strong><br>Build out your project into a playable game, swap out placeholders with final assets, and playtest, playtest, playtest.<strong></strong><br> July 15: Sprint 3 Begins (10:00am PDT)<br> July 27: Sprint 3 Deadline (11:59pm PDT)<br> July 28: Review &amp; Feedback Period</p>
<p><strong>Sprint 4: Polish, Promotion &amp; Marketing</strong><br>Debug, tune, and polish your game. Create promo materials and release on itch.io.<strong></strong><br> July 30: Sprint 4 Begins (10:00am PDT)<br> August 12: Final Submission Deadline (11:59pm PDT)<br> August 13: Review &amp; Feedback Period / Voting Begins</p>
<p><strong>Community Voting<br></strong> August 19: Voting Closes (11:59pm PDT)<br> TBA: Voting Results Announced</p>
<hr>
<p><strong>SUBMISSION RULES</strong><br>Create your game during the jam (July 1–August 11, 2026).</p>
<p>We strongly recommend that you follow&nbsp;the sprint schedule and submit materials for sprints 1-3, which each have their own itch.io page.</p>
<p><strong>itch.io pages:</strong><br></p>
<ul><li>Sprint 1: <a href="https://itch.io/jam/climate-jam-2026-sprint-1" target="_blank">Ideation</a></li><li>Sprint 2: <a href="https://itch.io/jam/climate-jam-2026-sprint-2" target="_blank">Pre-Production</a></li><li>Sprint 3: <a href="https://itch.io/jam/climate-jam-2026-sprint-3" target="_blank">Full Production</a><strong></strong></li></ul>
<p>You will submit your final project to the main Climate Jam itch.io page (this page).
</p>
<p>Note: AI-assisted content is permitted but must be disclosed. We encourage participants to use AI thoughtfully and consider its environmental impact.</p>
<hr>
<p><strong>CLIMATE SOLUTIONS RUBRIC</strong><br>The best &quot;Climate Solutions&quot; games will:<strong></strong></p>
<ul><li>Be grounded in real scientific evidence.
</li><li>Highlight positive climate solutions.
</li><li>Be engaging, immersive, and interactive.
</li><li>Make thoughtful use of game design and technology.
</li><li>Have a clear target audience.
</li><li>Include a solution-focused call to action.
</li><li>Foster community, collaboration, and social connection.
</li></ul>
<hr>
<p><strong>COMMUNITY &amp; RESOURCES</strong><br>We use Discord for our online jam community hub.</p>
<ol><li>(if you are new to the server) Join IndieCade’s Discord server: <a href="https://www.indiecade.com/discord" referrerpolicy="origin" rel="nofollow noopener">https://www.indiecade.com/discord
</a>
</li><li>(if you are new to the server) Click the green checkmark in the #code-of-conduct channel to acknowledge the rules and access the general server channels.
</li><li>Enter in the following command code in the #lounge channel to receive the &quot;Climate Jammer” role: !climate
</li></ol>
<p>Guides, talks, sample projects, and other resources will be shared throughout the the jam.
</p>
<p>We&#x27;ve schedule a day between each sprint for teams to focus on reviewing each other&#x27;s submissions and providing feedback.&nbsp;</p>
<p><a href="https://itch.io/jam/climate-jam-2025/entries"></a></p>
<hr>
<p><strong>CLIMATE SOLUTIONS ANTHOLOGY</strong><br>Selected Climate Jam projects may be invited to join the Climate Solutions Anthology, a collection of standout games that IndieCade plans to release on Steam.</p>
<p>Invited games will be evaluated on quality, creativity, and alignment with the&nbsp;<a href="https://itch.io/jam/climate-jam-2026/topic/6590011/climate-solutions-rubric" target="_blank">Climate Solutions Rubric</a>. Games must be playable in English, and teams must own or have permission to use all included assets.
</p>
<hr>
<p><strong>GET INVOLVED</strong><br>Interested in mentoring, judging, or contributing to Climate Jam?&nbsp;Sign up through the <a href="https://form.jotform.com/261597065959172" style="" referrerpolicy="origin" rel="nofollow noopener">Mentor / Contributor form</a> or contact us at <a href="mailto:jams@indiecade.com" style="" referrerpolicy="origin" rel="nofollow noopener">jams@indiecade.com</a>.<br></p>
<hr>
<p><strong>SPONSORS &amp; PARTNERS</strong><br><a target="_blank" href="https://www.indiecade.com/horizons/" style="" referrerpolicy="origin" rel="nofollow noopener">IndieCade Horizons<br></a><a target="_blank" href="https://www.seattleindies.org/" style="" referrerpolicy="origin" rel="nofollow noopener">Seattle Indies<br></a><a target="_blank" href="https://earthgames.org/" style="" referrerpolicy="origin" rel="nofollow noopener">EarthGames&nbsp;<br></a><a target="_blank" href="https://globalgamejam.org/" style="" referrerpolicy="origin" rel="nofollow noopener">Global Game Jam<br></a><a target="_blank" href="https://www.gamesforchange.org/" referrerpolicy="origin" rel="nofollow noopener">Games for Change</a><span></span></p>
<p>Interested in partnering with Climate Jam? Contact us at&nbsp;<a href="mailto:jams@indiecade.com" referrerpolicy="origin" rel="nofollow noopener">jams@indiecade.com</a></p>
<p><img src="https://img.itch.zone/aW1nLzI4NTExMDIzLnBuZw==/original/MjKYGZ.png" loading="lazy"><br></p>
<p><span></span></p>
<hr>
<p><strong>SUPPORT INDIECADE</strong><br>IndieCade exists to support the independent development community and to shine a light on diverse and expansive work from around the world. <strong>Memberships</strong> provide the crucial support to make this mission possible. <a style="" href="https://www.indiecade.com/memberships/" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Learn more and become a member.</a></p>
<p>If you would like to help support IndieCade directly, please consider <strong>donating</strong>. As a volunteer-based entity every contribution makes a huge difference for our being able to support and highlight game creators. <a href="https://pci.jotform.com/form/260667335877168" target="_blank" referrerpolicy="origin" rel="nofollow noopener">Donate today.</a></p>
<p>If you would like to become and IndieCade <strong>Sponsor</strong> or <strong>Academic Partner</strong>, please <a href="https://www.indiecade.com/sponsorships/" referrerpolicy="origin" rel="nofollow noopener">provide your information</a> and we&#x27;ll contact you as soon as possible.<br></p></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div tabIndex="-1" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login has_fields lightbox" id="add_game_to_jam_lightbox_9307872" role="dialog"><button class="close_button"><svg class="svgicon icon_cross2" stroke="currentColor" width="18" height="18" stroke-linecap="round" stroke-linejoin="round" aria-hidden fill="none" stroke-width="2" version="1.1" viewBox="0 0 24 24" role="img"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a class="button" data-register_action="jam_submit" href="/login?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fclimate-jam-2026&amp;intent=jam_submit">Log in</a><span class="or_split"> or </span><a class="button" data-register_action="jam_submit" href="/register?return_to=https%3A%2F%2Fitch.io%2Fjam%2Fclimate-jam-2026&amp;intent=jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_2760276', {"voting_end_date":"2026-08-19 06:59:59","id":414042,"end_date":"2026-08-12 06:59:59","start_date":"2026-07-01 17:00:00"});init_JamLayoutHeader('#jam_layout_header_5265364', {"autocomplete_props":{"i18n":{"search":"Search","search_placeholder":"Search for games, jams, tags or creators"},"ca_source":25,"ca_types":{"featured_tag":7,"browse_facet":8,"game":1,"jam":4,"bundle":6},"autocomplete_url":"\/autocomplete","search_url":"\/search"}});
I.setup_page();</script></body></html>