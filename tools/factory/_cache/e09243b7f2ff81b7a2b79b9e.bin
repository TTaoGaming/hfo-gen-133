header" href="/login" data-label="log_in" class="panel_button">Log in</a><a data-register_action="header" href="/register" data-label="register" class="panel_button register_button">Register</a></div></div><div class="header_dropdown" data-target="browse"><a href="/games/store">Indie game store</a><a href="/games/free">Free games</a><a href="/games/fun">Fun games</a><a href="/games/tag-horror">Horror games</a><div class="divider"></div><a href="/tools">Game development</a><a href="/game-assets">Assets</a><a href="/comics">Comics</a><div class="divider"></div><a href="/sales">Sales</a><a href="/bundles">Bundles</a><div class="divider"></div><a href="/jobs">Jobs</a><div class="divider"></div><a href="/tags">Tags</a><a href="/game-development/engines">Game Engines</a></div></div><div class="jam_page_wrap" id="wrapper"><div class="view_jam_page view_jam_base_page page_widget base_widget view_jam_default after_voting is_over has_banner" id="view_jam_9366054"><div class="jam_banner_outer"><img src="https://img.itch.zone/aW1hZ2UyL2phbS80MDg0NjYvMjIyNTMyNzQucG5n/original/o%2BUnNZ.png" class="jam_banner "/></div><div class="jam_body"><div class="jam_header_widget base_widget" id="jam_header_8378286"><div class="header_inner"><div class="header_columns"><div class="title_colum"><h1 class="jam_title_header"><a href="/jam/kenney-jam-2026">Kenney Jam 2026</a></h1><div class="jam_host_header">Hosted by <a href="https://kenney.itch.io">Kenney</a>, <a href="https://kaylousberg.itch.io">Kay Lousberg</a> · <a href="https://bsky.app/hashtag/kenneyjam">#kenneyjam</a></div></div><div class="stats_container"><div class="stat_box"><a href="/jam/kenney-jam-2026/entries"><div class="stat_value">572</div><div class="stat_label">Entries</div></a></div></div></div><div class="header_tabs"><a href="/jam/kenney-jam-2026" data-label="tab_view_jam" class="header_tab active">Overview</a><a href="/jam/kenney-jam-2026/entries" data-label="tab_view_jam_entries" class="header_tab">Submissions</a><a href="/jam/kenney-jam-2026/results" class="header_tab">Results</a><div class="tab_group"><a href="/jam/kenney-jam-2026/community" class="header_tab">Community</a><span class="community_activity">107</span></div><a href="/jam/kenney-jam-2026/feed" data-label="tab_view_jam_feed" class="header_tab">Submission feed</a></div></div></div><div class="submitter_outer"><div class="jam_submitter_widget base_widget after_voting is_over" id="jam_submitter_281071"><p>This jam is now over. It ran from <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-17 15:00:00</span> to <span data-format="MMMM Do YYYY [at] h:mm A" class="date_format">2026-07-19 17:00:00</span>. <a href="/jam/kenney-jam-2026/results">View results</a></p></div></div><div class="jam_content user_formatted"><hr>
<p></p>
<div class="custom-clear"></div>
<h4>Create a game using only game assets made by <a href="https://kenney.nl/assets" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Kenney</a> or <a href="https://kaylousberg.itch.io/" target="_blank">KayKit</a></h4>
<p class="text-center">You can use, edit, and remix them however you like <em>(see our rules below)</em>. A theme is announced at the beginning of the jam. Join our <a href="https://social.kenney.nl/discord" target="_blank" rel="nofollow noopener" referrerpolicy="origin">Discord server</a> and use hashtag <strong>#kenneyjam</strong> on social media.</p>
<p>
</p>
<figure>
<a target="_blank" href="https://kenney.nl/assets/" class="custom-promo" rel="nofollow noopener" referrerpolicy="origin"><img src="https://img.itch.zone/aW1nLzIxNTM5NDg5LnBuZw==/original/bDMHKV.png" loading="lazy"></a>
<a target="_blank" href="https://kaylousberg.itch.io/" class="custom-promo"><img src="https://img.itch.zone/aW1nLzIxNTM5NDkwLnBuZw==/original/WrWQRR.png" loading="lazy"></a>
</figure>
<p class="text-center">🎁 <a target="_blank" href="https://kenney.nl/assets" rel="nofollow noopener" referrerpolicy="origin">Find all Kenney game assets here</a>&nbsp;&amp; <a href="https://kaylousberg.itch.io/" target="_blank">KayKit game assets here</a> 🎁</p>
<p></p>
<hr>
<h3>Theme</h3>
<p>The Kenney Jam 2026 theme is... <strong>SCALE</strong></p>
<figure><img src="https://img.itch.zone/aW1nLzI4NTUyMDAyLnBuZw==/original/zDEVKc.png" loading="lazy"></figure>
<h3>Grand prize</h3>
<figure><img src="https://img.itch.zone/aW1nLzI4MzQ2NDgxLnBuZw==/original/RJt%2FRW.png" loading="lazy"></figure>
<p>Our <strong>grand prize</strong> includes a glass personalized trophy for you (or your team), a 9&quot; Kenney plush, exclusive Kenney &amp; KayKit merchandise and a digital copy of <a href="https://kaylousberg.itch.io/kaykit-complete" target="_blank">The Complete KayKit Collection</a>, <a href="https://kenney.itch.io/kenney-game-assets" target="_blank">Kenney Game Assets All-in-1</a> and <a href="https://kenney.itch.io/assetforge-deluxe" target="_blank">Asset Forge Deluxe</a>!</p>
<h3>Rules &amp; FAQ</h3>
<p><strong>✅ Required</strong></p>
<ul>
<li>Use only the provided game assets</li>
<li>Create a game incorporating the theme</li>
</ul>
<p><strong>⭕ Allowed</strong></p>
<ul>
<li>Edit <em>(recolor, crop, rotate, flip and scale)</em> and combine assets</li>
<li>Custom animations (for sprites and 3D models)</li>
<li>Custom materials, shaders, VFX and particles (textures should be sourced from the assets)</li>
<li>Custom audio (sound effects and music) and font(s)</li>
<li>Custom game and studio logo, mandatory splashscreen(s) and game engine logos</li>
<li>Code related assets, templates &amp; plug-ins</li>
</ul>
<p><strong>❌ Not allowed</strong></p>
<ul>
<li>Create or use custom art or models</li>
<li>Models, textures or other visual assets that are bundled with the game engine</li>
<li>Generative AI or AI assisted (code, art or audio)</li>
</ul>
<p>
ℹ️ If you feel your question hasn&#x27;t been answered yet, we trust you to use your own judgement. It&#x27;s meant to be a game jam where you challenge yourself to only use premade assets. Trying to think of edge-cases to circumvent these rules is not within the spirit of the game jam.
</p>
<h3>✨ Bonus challenges</h3>
<p>For experienced jammers we&#x27;ve got optional bonus challenges! Pick any to create an even bigger challenge for yourself, or your team;</p>
<ol>
<li><strong>Single pack:</strong> Your game should only use a single asset pack</li>
<li><strong>No text:</strong> Create a game that doesn&#x27;t use any text at all</li>
<li><strong>Mouse only:</strong> Your game should be fully controlled using only the mouse</li>
<li><strong>Co-op:</strong> Your game should feature co-op gameplay</li>
<li><strong>Symmetry:</strong> Your game should heavily feature symmetrical elements in visuals, mechanics or both</li>
<li><strong>Cross Dimensional:</strong> Use 2D sprites in a 3D world</li>
</ol>
<h3>Previous years</h3>
<ul>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2025">Kenney Jam 2025</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2024">Kenney Jam 2024</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2023">Kenney Jam 2023</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2022">Kenney Jam 2022</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2021">Kenney Jam 2021</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2020">Kenney Jam 2020</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2019">Kenney Jam 2019</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2018">Kenney Jam 2018</a></li>
<li><a target="_blank" href="https://itch.io/jam/kenney-jam-2017">Kenney Jam 2017</a></li>
</ul></div></div><script type="text/template" id="add_game_to_jam_lightbox_tpl"><div id="add_game_to_jam_lightbox_1357295" class="add_game_to_jam_lightbox_widget lightbox_widget base_widget  force_login has_fields lightbox" role="dialog" tabIndex="-1"><button class="close_button"><svg class="svgicon icon_cross2" role="img" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" width="18" height="18" stroke-linejoin="round" aria-hidden version="1.1"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button><h2>Log in to continue</h2><p>This jam is using <a target="_blank" href="http://itch.io">itch.io</a> to host entries. You&#039;ll need to register or log in on
      itch.io in order to <span class="on_submit">submit your game</span><span class="on_join">join this jam</span>.</p><p class="on_submit">After signing in you can create a new game on itch.io then
      return here and click the <em>submit game</em> button again to enter your game.</p><p><a class="button" href="/login?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fkenney-jam-2026" data-register_action="jam_submit">Log in</a><span class="or_split"> or </span><a class="button" href="/register?intent=jam_submit&amp;return_to=https%3A%2F%2Fitch.io%2Fjam%2Fkenney-jam-2026" data-register_action="jam_submit">Register</a></p></div></script></div></div><script type="text/template" id="loading_lightbox_tpl"><div aria-live="polite" class="lightbox loading_lightbox"><div class="loader_outer"><div class="loader_label">Loading</div><div class="loader_bar"><div class="loader_bar_slider"></div></div></div></div></script><script type="text/javascript">new I.ViewJam('#view_jam_9366054', {"voting_end_date":"2026-07-28 15:00:00","id":408466,"start_date":"2026-07-17 15:00:00","end_date":"2026-07-19 17:00:00"});init_JamLayoutHeader('#jam_layout_header_6087716', {"autocomplete_props":{"search_url":"\/search","autocomplete_url":"\/autocomplete","ca_source":25,"ca_types":{"game":1,"jam":4,"bundle":6,"browse_facet":8,"featured_tag":7},"i18n":{"search_placeholder":"Search for games, jams, tags or creators","search":"Search"}}});
